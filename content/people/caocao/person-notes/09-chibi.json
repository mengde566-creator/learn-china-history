{
  "people": [
    {
      "id": "liu-biao",
      "name": "刘表",
      "versions": [
        {
          "from": 1,
          "to": 9,
          "text": "刘表是荆州牧，据有荆州近二十年。本篇开头他去世，儿子刘琮接任；他生前未能阻止曹操南征。",
          "sources": [
            {
              "kind": "local",
              "id": "064"
            },
            {
              "kind": "external",
              "book": "《三国志》",
              "section": "卷六·刘表传",
              "url": "https://zh.wikisource.org/wiki/三國志/卷06"
            }
          ]
        }
      ]
    },
    {
      "id": "liu-cong",
      "name": "刘琮",
      "versions": [
        {
          "from": 1,
          "to": 9,
          "text": "刘琮是刘表的儿子。刘表死后他接掌荆州，屯襄阳；曹操到新野时，他举州投降。后来曹操任他为青州刺史、封列侯。",
          "sources": [
            {
              "kind": "local",
              "id": "064"
            },
            {
              "kind": "external",
              "book": "《三国志》",
              "section": "卷六·刘表传",
              "url": "https://zh.wikisource.org/wiki/三國志/卷06"
            }
          ]
        }
      ]
    },
    {
      "id": "liu-bei",
      "name": "刘备",
      "versions": [
        {
          "from": 1,
          "to": 9,
          "text": "刘备是曹操的对手，当时屯樊。刘琮降后他走夏口，与孙权联合抗曹；后来取得荆州江南诸郡和益州，最终称帝，建立蜀汉。",
          "sources": [
            {
              "kind": "local",
              "id": "064"
            },
            {
              "kind": "local",
              "id": "065"
            },
            {
              "kind": "external",
              "book": "《三国志》",
              "section": "卷三十二·先主传",
              "url": "https://zh.wikisource.org/wiki/三國志/卷32"
            }
          ]
        }
      ]
    },
    {
      "id": "wen-pin",
      "name": "文聘",
      "versions": [
        {
          "from": 3,
          "to": 9,
          "text": "文聘原是刘表的大将。刘琮降后，曹操任他为江夏太守，仍统旧兵；后来他长期镇守江夏，官至后将军。",
          "sources": [
            {
              "kind": "local",
              "id": "064"
            },
            {
              "kind": "external",
              "book": "《三国志》",
              "section": "卷十八·文聘传",
              "url": "https://zh.wikisource.org/wiki/三國志/卷18"
            }
          ]
        }
      ]
    },
    {
      "id": "han-song",
      "name": "韩嵩",
      "versions": [
        {
          "from": 3,
          "to": 9,
          "text": "韩嵩是荆州名士。曹操进江陵后引用荆州名士，他与邓义都在其中；所取材料未展开他的具体职任。",
          "sources": [
            {
              "kind": "local",
              "id": "064"
            }
          ]
        }
      ]
    },
    {
      "id": "deng-yi",
      "name": "邓义",
      "versions": [
        {
          "from": 3,
          "to": 9,
          "text": "邓义是荆州名士，与韩嵩同被曹操引用；所取材料未展开他的具体职任。",
          "sources": [
            {
              "kind": "local",
              "id": "064"
            }
          ]
        }
      ]
    },
    {
      "id": "zhuge-liang",
      "name": "诸葛亮",
      "versions": [
        {
          "from": 4,
          "to": 9,
          "text": "诸葛亮是刘备的谋士。本篇刘备退到夏口后派他出使孙权，促成孙刘联合；后来他任蜀汉丞相。",
          "sources": [
            {
              "kind": "local",
              "id": "113"
            },
            {
              "kind": "external",
              "book": "《三国志》",
              "section": "卷三十五·诸葛亮传",
              "url": "https://zh.wikisource.org/wiki/三國志/卷35"
            }
          ]
        }
      ]
    },
    {
      "id": "sun-quan",
      "name": "孙权",
      "versions": [
        {
          "from": 4,
          "to": 9,
          "text": "孙权是江东之主。本篇他遣周瑜、程普与刘备合兵迎曹；后来称帝，建立吴。",
          "sources": [
            {
              "kind": "local",
              "id": "113"
            },
            {
              "kind": "external",
              "book": "《三国志》",
              "section": "卷四十七·吴主传",
              "url": "https://zh.wikisource.org/wiki/三國志/卷47"
            }
          ]
        }
      ]
    },
    {
      "id": "zhou-yu",
      "name": "周瑜",
      "versions": [
        {
          "from": 4,
          "to": 9,
          "text": "周瑜是孙权派出的主将，与刘备合兵迎曹，赤壁之战由他指挥；后来攻南郡，病卒。",
          "sources": [
            {
              "kind": "local",
              "id": "113"
            },
            {
              "kind": "local",
              "id": "114"
            },
            {
              "kind": "external",
              "book": "《三国志》",
              "section": "卷五十四·周瑜传",
              "url": "https://zh.wikisource.org/wiki/三國志/卷54"
            }
          ]
        }
      ]
    },
    {
      "id": "cheng-pu",
      "name": "程普",
      "versions": [
        {
          "from": 4,
          "to": 9,
          "text": "程普是东吴老将，与周瑜同被派出；后来仍在东吴任将。",
          "sources": [
            {
              "kind": "local",
              "id": "113"
            },
            {
              "kind": "external",
              "book": "《三国志》",
              "section": "卷五十五·程普传、黄盖传",
              "url": "https://zh.wikisource.org/wiki/三國志/卷55"
            }
          ]
        }
      ]
    },
    {
      "id": "huang-gai",
      "name": "黄盖",
      "versions": [
        {
          "from": 6,
          "to": 9,
          "text": "黄盖是周瑜的部将。本篇他献火攻计并诈降，率船纵火；后来任武陵太守，卒于官。",
          "sources": [
            {
              "kind": "local",
              "id": "113"
            },
            {
              "kind": "local",
              "id": "114"
            },
            {
              "kind": "external",
              "book": "《三国志》",
              "section": "卷五十五·程普传、黄盖传",
              "url": "https://zh.wikisource.org/wiki/三國志/卷55"
            }
          ]
        }
      ]
    }
  ],
