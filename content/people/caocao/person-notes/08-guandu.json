{
  "people": [
    {
      "id": "yuan-shao",
      "name": "袁绍",
      "versions": [
        {
          "from": 1,
          "to": 9,
          "text": "袁绍是河北的割据者，此时兼有四州。本篇他率大军南下，与曹操在官渡相持；后来乌巢粮被烧、张郃等降曹，他弃军渡河北走，两年后病逝。",
          "sources": [
            {
              "kind": "local",
              "id": "040"
            },
            {
              "kind": "local",
              "id": "045"
            },
            {
              "kind": "external",
              "book": "《三国志》",
              "section": "卷六·袁绍传附袁谭",
              "url": "https://zh.wikisource.org/wiki/三國志/卷06"
            }
          ]
        }
      ]
    },
    {
      "id": "xun-yu",
      "name": "荀彧",
      "versions": [
        {
          "from": 4,
          "to": 9,
          "text": "荀彧是曹操的谋士，本篇留守许都。曹操粮尽想退，他回信劝其坚持；后来因反对曹操进爵魏公，以忧而卒。",
          "sources": [
            {
              "kind": "local",
              "id": "044"
            },
            {
              "kind": "external",
              "book": "《三国志》",
              "section": "卷十·荀彧传、荀攸传、贾诩传",
              "url": "https://zh.wikisource.org/wiki/三國志/卷10"
            }
          ]
        }
      ]
    },
    {
      "id": "xun-you",
      "name": "荀攸",
      "versions": [
        {
          "from": 5,
          "to": 9,
          "text": "荀攸是曹操的谋士。本篇他献计截烧袁绍运粮车，又在许攸来投时与贾诩劝曹操采纳突袭乌巢之计。",
          "sources": [
            {
              "kind": "local",
              "id": "044"
            },
            {
              "kind": "external",
              "book": "《三国志》",
              "section": "卷十·荀彧传、荀攸传、贾诩传",
              "url": "https://zh.wikisource.org/wiki/三國志/卷10"
            }
          ]
        }
      ]
    },
    {
      "id": "xu-huang",
      "name": "徐晃",
      "versions": [
        {
          "from": 5,
          "to": 9,
          "text": "徐晃是曹操的部将。本篇奉命与史涣截击袁绍运粮车，将其烧毁；后来在曹操麾下屡立战功，官至右将军。",
          "sources": [
            {
              "kind": "local",
              "id": "044"
            },
            {
              "kind": "external",
              "book": "《三国志》",
              "section": "卷十七·徐晃传、张郃传",
              "url": "https://zh.wikisource.org/wiki/三國志/卷17"
            }
          ]
        }
      ]
    },
    {
      "id": "shi-huan",
      "name": "史涣",
      "versions": [
        {
          "from": 5,
          "to": 9,
          "text": "史涣是曹操的部将。本篇与徐晃截烧袁绍运粮车；此后材料未载其在本篇之后的经历。",
          "sources": [
            {
              "kind": "local",
              "id": "044"
            }
          ]
        }
      ]
    },
    {
      "id": "chunyu-qiong",
      "name": "淳于琼",
      "versions": [
        {
          "from": 6,
          "to": 9,
          "text": "淳于琼是袁绍的部将。本篇他率万余兵护送粮车，宿在乌巢；曹操夜袭，他被击破。",
          "sources": [
            {
              "kind": "local",
              "id": "044"
            },
            {
              "kind": "local",
              "id": "045"
            }
          ]
        }
      ]
    },
    {
      "id": "xu-you",
      "name": "许攸",
      "versions": [
        {
          "from": 6,
          "to": 9,
          "text": "许攸是袁绍的谋臣。本篇他来投曹操，告知乌巢粮屯所在，劝其轻兵突袭；后来因恃功骄纵，被曹操处死。",
          "sources": [
            {
              "kind": "local",
              "id": "044"
            },
            {
              "kind": "local",
              "id": "042"
            }
          ]
        }
      ]
    },
    {
      "id": "jia-xu",
      "name": "贾诩",
      "versions": [
        {
          "from": 6,
          "to": 9,
          "text": "贾诩是曹操的谋士。本篇许攸来投时，他与荀攸劝曹操采纳突袭乌巢之计；后来官至太尉。",
          "sources": [
            {
              "kind": "local",
              "id": "044"
            },
            {
              "kind": "external",
              "book": "《三国志》",
              "section": "卷十·荀彧传、荀攸传、贾诩传",
              "url": "https://zh.wikisource.org/wiki/三國志/卷10"
            }
          ]
        }
      ]
    },
    {
      "id": "cao-hong",
      "name": "曹洪",
      "versions": [
        {
          "from": 7,
          "to": 9,
          "text": "曹洪是曹操的从弟，本篇留守大营，抵挡张郃、高览进攻。后来官至骠骑将军。",
          "sources": [
            {
              "kind": "local",
              "id": "045"
            },
            {
              "kind": "external",
              "book": "《三国志》",
              "section": "卷九·曹洪传",
              "url": "https://zh.wikisource.org/wiki/三國志/卷09"
            }
          ]
        }
      ]
    },
    {
      "id": "yuan-tan",
      "name": "袁谭",
      "versions": [
        {
          "from": 9,
          "to": 9,
          "text": "袁谭是袁绍的长子。本篇袁绍对他说要攻曹营；袁军溃后，他与父亲弃军渡河。后来他与弟弟袁尚相攻，被曹操击败杀死。",
          "sources": [
            {
              "kind": "local",
              "id": "045"
            },
            {
              "kind": "external",
              "book": "《三国志》",
              "section": "卷六·袁绍传附袁谭",
              "url": "https://zh.wikisource.org/wiki/三國志/卷06"
            }
          ]
        }
      ]
    },
    {
      "id": "zhang-he",
      "name": "张郃",
      "versions": [
        {
          "from": 9,
          "to": 9,
          "text": "张郃是袁绍的部将。本篇与高览奉命攻曹洪，听说乌巢被破，遂降曹操；后来成为曹魏名将，官至征西车骑将军。",
          "sources": [
            {
              "kind": "local",
              "id": "045"
            },
            {
              "kind": "external",
              "book": "《三国志》",
              "section": "卷十七·徐晃传、张郃传",
              "url": "https://zh.wikisource.org/wiki/三國志/卷17"
            }
          ]
        }
      ]
    },
    {
      "id": "gao-lan",
      "name": "高览",
      "versions": [
        {
          "from": 9,
          "to": 9,
          "text": "高览是袁绍的部将。本篇与张郃攻曹洪，后一同降曹；此后材料未载其显著经历。",
          "sources": [
            {
              "kind": "local",
              "id": "045"
            }
          ]
        }
      ]
    }
  ],
  "occurrences": [
    {
      "personId": "yuan-shao",
      "beat": 1,
      "paragraph": 0,
      "offset": 7,
      "text": "袁绍",
      "paragraphText": "曹操说，他了解袁绍的为人："
    },
    {
      "personId": "xun-yu",
      "beat": 4,
      "paragraph": 1,
      "offset": 8,
      "text": "荀彧",
      "paragraphText": "曹操写了一封信给荀彧，信里说的是：想退回去，守许都。"
    },
    {
      "personId": "xun-you",
      "beat": 5,
      "paragraph": 0,
      "offset": 16,
      "text": "荀攸",
      "paragraphText": "袁绍运粮的几千辆车到了。曹操采用荀攸的计策，派徐晃、史涣截击，把车全部烧掉。"
    },
    {
      "personId": "xu-huang",
      "beat": 5,
      "paragraph": 0,
      "offset": 23,
      "text": "徐晃",
      "paragraphText": "袁绍运粮的几千辆车到了。曹操采用荀攸的计策，派徐晃、史涣截击，把车全部烧掉。"
    },
    {
      "personId": "shi-huan",
      "beat": 5,
      "paragraph": 0,
      "offset": 26,
      "text": "史涣",
      "paragraphText": "袁绍运粮的几千辆车到了。曹操采用荀攸的计策，派徐晃、史涣截击，把车全部烧掉。"
    },
    {
      "personId": "chunyu-qiong",
      "beat": 6,
      "paragraph": 0,
      "offset": 8,
      "text": "淳于琼",
      "paragraphText": "冬十月，袁绍又派淳于琼等人领万余兵护送粮车。淳于琼一部宿在袁绍大营以北四十里。"
    },
    {
      "personId": "xu-you",
      "beat": 6,
      "paragraph": 1,
      "offset": 5,
      "text": "许攸",
      "paragraphText": "袁绍的谋臣许攸来投曹操，劝他袭击淳于琼。"
    },
    {
      "personId": "jia-xu",
      "beat": 6,
      "paragraph": 6,
      "offset": 17,
      "text": "贾诩",
      "paragraphText": "《武帝纪》记，左右有人怀疑，荀攸、贾诩却劝曹操采纳。"
    },
    {
      "personId": "cao-hong",
      "beat": 7,
      "paragraph": 0,
      "offset": 4,
      "text": "曹洪",
      "paragraphText": "曹操留下曹洪守营，亲自带五千步骑连夜出发。"
    },
    {
      "personId": "yuan-tan",
      "beat": 9,
      "paragraph": 0,
      "offset": 15,
      "text": "袁谭",
      "paragraphText": "袁绍听说曹操去打淳于琼，对长子袁谭说："
    },
    {
      "personId": "zhang-he",
      "beat": 9,
      "paragraph": 3,
      "offset": 2,
      "text": "张郃",
      "paragraphText": "他派张郃、高览去攻曹洪。"
    },
    {
      "personId": "gao-lan",
      "beat": 9,
      "paragraph": 3,
      "offset": 5,
      "text": "高览",
      "paragraphText": "他派张郃、高览去攻曹洪。"
    }
  ]
}
