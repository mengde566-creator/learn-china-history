  "occurrences": [
    {
      "personId": "pingyuan-jun",
      "beat": 1,
      "paragraph": 1,
      "offset": 5,
      "text": "平原君",
      "paragraphText": "他收租税，平原君家不肯出租。赵奢依法办理，杀了平原君家九个管事的人。"
    },
    {
      "personId": "zhao-huiwen",
      "beat": 4,
      "paragraph": 0,
      "offset": 13,
      "text": "赵王",
      "paragraphText": "平原君认为他贤，把他推荐给赵王。赵王用他治理国家赋税，国赋大平，民富而府库实。"
    }
  ]
