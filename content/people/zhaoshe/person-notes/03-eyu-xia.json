            }
          ]
        }
      ]
    },
    {
      "id": "zhao-huiwen",
      "name": "趙惠文王",
      "versions": [
        {
          "from": 6,
          "to": 6,
          "text": "趙惠文王是趙國之君。本篇閼與戰後，他賜趙奢號馬服君，以許歷為國尉；趙奢由此與廉頗、藺相如同位。",
          "sources": [
            {
              "kind": "local",
              "id": "029"
            },
            {
              "kind": "local",
              "id": "030"
            },
            {
              "kind": "external",
              "book": "《史記》",
              "section": "卷八十一·廉頗藺相如列傳",
              "url": "https://zh.wikisource.org/wiki/史記/卷081"
            }
          ]
        }
      ]
    },
    {
      "id": "lian-po",
      "name": "廉頗",
      "versions": [
        {
          "from": 6,
          "to": 6,
          "text": "廉頗是趙國名將。本篇結尾說趙奢與他、藺相如同位；後來長平之戰，他固壁不戰，被趙括代替。",
          "sources": [
            {
              "kind": "local",
              "id": "030"
            },
            {
              "kind": "local",
              "id": "032"
            },
            {
              "kind": "external",
              "book": "《史記》",
              "section": "卷八十一·廉頗藺相如列傳",
              "url": "https://zh.wikisource.org/wiki/史記/卷081"
            }
          ]
        }
      ]
    },
    {
      "id": "lin-xiangru",
      "name": "藺相如",
      "versions": [
        {
          "from": 6,
          "to": 6,
          "text": "藺相如是趙國上卿。本篇結尾說趙奢與他、廉頗同位；後來長平之戰前，他病重，仍諫趙王勿以趙括為將。",
          "sources": [
