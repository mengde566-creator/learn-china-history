        }
      ]
    },
    {
      "id": "zhao-huiwen",
      "name": "赵惠文王",
      "versions": [
        {
          "from": 6,
          "to": 6,
          "text": "赵惠文王是赵国之君。本篇阏与战后，他赐赵奢号马服君，以许历为国尉；赵奢由此与廉颇、蔺相如同位。",
          "sources": [
            {
