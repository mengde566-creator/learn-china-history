    {
      "id": "yue-cheng",
      "name": "樂乘",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "樂乘是趙將。本篇趙王問救閼與，他的回答與廉頗相同；後來趙悼襄王以樂乘代廉頗，廉頗怒而攻之，樂乘走。",
          "sources": [
