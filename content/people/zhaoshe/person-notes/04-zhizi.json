    }
  ],
  "occurrences": [
    {
      "personId": "zhao-kuo",
      "beat": 1,
      "paragraph": 0,
      "offset": 0,
      "text": "赵括",
      "paragraphText": "赵括自小学习兵法，谈论兵事，认为天下没有人能抵得上他。"
    },
    {
      "personId": "kuo-mu",
      "beat": 3,
      "paragraph": 0,
      "offset": 0,
      "text": "赵括的母亲",
      "paragraphText": "赵括的母亲问赵奢其中的缘故。赵奢说："
    },
    {
      "personId": "lin-xiangru",
      "beat": 4,
      "paragraph": 0,
      "offset": 44,
      "text": "蔺相如",
      "paragraphText": "四年后，赵惠文王去世，儿子孝成王即位。孝成王七年，秦与赵兵在长平相拒；这时赵奢已经死了，蔺相如病重。"
    }
  ]
}
