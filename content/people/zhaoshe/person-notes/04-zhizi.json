{
  "people": [
    {
      "id": "zhao-kuo",
      "name": "赵括",
      "versions": [
        {
          "from": 1,
          "to": 4,
          "text": "赵括是赵奢之子，自少学兵法，言兵事，以为天下莫能当。本篇他与父亲谈兵，赵奢难不住他，却不认为他好；赵奢说「兵，死地也，而括易言之」，并预言破赵军者必括。",
          "sources": [
            {
              "kind": "local",
              "id": "039"
            },
            {
              "kind": "local",
              "id": "040"
            },
            {
