{
  "people": [
    {
      "id": "zhao-kuo",
      "name": "趙括",
      "versions": [
        {
          "from": 1,
          "to": 4,
          "text": "趙括是趙奢之子，自少學兵法，言兵事，以為天下莫能當。本篇他與父親談兵，趙奢難不住他，卻不認為他好；趙奢說「兵，死地也，而括易言之」，並預言破趙軍者必括。",
          "sources": [
            {
              "kind": "local",
              "id": "039"
            },
            {
              "kind": "local",
              "id": "040"
            },
            {
              "kind": "local",
              "id": "041"
            },
            {
