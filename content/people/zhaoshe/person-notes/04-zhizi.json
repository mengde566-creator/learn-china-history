            },
            {
              "kind": "external",
              "book": "《史記》",
              "section": "卷八十一·廉頗藺相如列傳",
              "url": "https://zh.wikisource.org/wiki/史記/卷081"
            }
          ]
        }
      ]
    },
    {
      "id": "kuo-mu",
      "name": "括母",
      "versions": [
        {
          "from": 3,
          "to": 4,
          "text": "括母是趙括之母。本篇她問趙奢為何不認可兒子，得到「兵，死地也，而括易言之」的答覆；後來趙括將行，她上書諫阻，並求不隨坐。",
          "sources": [
            {
              "kind": "local",
              "id": "041"
            },
            {
              "kind": "local",
              "id": "043"
            },
            {
