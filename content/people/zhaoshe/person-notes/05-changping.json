              "book": "《史记》",
              "section": "卷八十一·廉颇蔺相如列传",
              "url": "https://zh.wikisource.org/wiki/史記/卷081"
            }
          ]
        }
      ]
    },
    {
      "id": "lin-xiangru",
      "name": "蔺相如",
      "versions": [
        {
          "from": 2,
          "to": 7,
          "text": "蔺相如是赵国上卿。本篇赵王以赵括代廉颇，他病中进谏「王以名使括，若胶柱而鼓瑟」，说赵括只读父书、不知合变；赵王不听。",
          "sources": [
            {
              "kind": "local",
              "id": "037"
            },
            {
              "kind": "local",
              "id": "038"
            },
            {
              "kind": "external",
              "book": "《史记》",
              "section": "卷八十一·廉颇蔺相如列传",
              "url": "https://zh.wikisource.org/wiki/史記/卷081"
            }
          ]
        }
      ]
    },
    {
      "id": "lian-po",
      "name": "廉颇",
      "versions": [
        {
          "from": 1,
          "to": 7,
          "text": "廉颇是赵国名将。本篇长平相拒，他固壁不战；赵王信秦反间，以赵括代他。",
          "sources": [
            {
              "kind": "local",
              "id": "032"
            },
            {
              "kind": "local",
              "id": "033"
            },
            {
              "kind": "local",
              "id": "036"
            },
            {
              "kind": "external",
              "book": "《史记》",
              "section": "卷八十一·廉颇蔺相如列传",
              "url": "https://zh.wikisource.org/wiki/史記/卷081"
            }
          ]
        }
      ]
    },
    {
      "id": "bai-qi",
      "name": "白起",
      "versions": [
        {
          "from": 5,
          "to": 7,
          "text": "白起是秦国名将。本篇赵括代廉颇后，他纵奇兵、佯败走、绝赵粮道、分断赵军，四十余日后射杀赵括。",
          "sources": [
            {
              "kind": "local",
              "id": "050"
            },
            {
              "kind": "local",
              "id": "051"
            },
            {
              "kind": "external",
              "book": "《史记》",
              "section": "卷八十一·廉颇蔺相如列传",
              "url": "https://zh.wikisource.org/wiki/史記/卷081"
            }
          ]
        }
      ]
    },
    {
      "id": "zhao-xiaocheng",
      "name": "赵孝成王",
      "versions": [
        {
          "from": 2,
          "to": 7,
          "text": "赵孝成王是赵国之君。本篇他信秦反间，以赵括代廉颇；蔺相如、括母先后进谏，他都不听，只说「已决」。长平败后，他因括母先言而不诛她。",
          "sources": [
            {
