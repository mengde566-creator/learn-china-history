{
  "people": [
    {
      "id": "zhao-kuo",
      "name": "趙括",
      "versions": [
        {
          "from": 1,
          "to": 7,
          "text": "趙括是趙奢之子。本篇秦反間稱「獨畏馬服君趙奢之子趙括」，趙王以他代廉頗；他悉更約束、易置軍吏，被白起斷糧分軍，四十餘日後戰死，趙軍降秦被坑。",
          "sources": [
            {
              "kind": "local",
              "id": "035"
            },
            {
              "kind": "local",
              "id": "036"
            },
            {
