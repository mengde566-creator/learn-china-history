      ]
    }
  ],
  "occurrences": [
    {
      "personId": "zhao-kuo",
      "beat": 1,
      "paragraph": 3,
      "offset": 5,
      "text": "赵括",
      "paragraphText": "赵王于是以赵括为将，代替廉颇。"
    },
    {
      "personId": "kuo-mu",
      "beat": 3,
      "paragraph": 0,
      "offset": 11,
      "text": "母亲",
      "paragraphText": "等到赵括将要出发，他的母亲上书对赵王说：「括不可使将。」"
    },
    {
      "personId": "lin-xiangru",
      "beat": 2,
      "paragraph": 0,
      "offset": 0,
      "text": "蔺相如",
      "paragraphText": "蔺相如说："
    },
    {
      "personId": "lian-po",
      "beat": 1,
      "paragraph": 3,
      "offset": 12,
      "text": "廉颇",
      "paragraphText": "赵王于是以赵括为将，代替廉颇。"
    },
    {
      "personId": "bai-qi",
      "beat": 5,
      "paragraph": 1,
      "offset": 2,
      "text": "白起",
      "paragraphText": "秦将白起听说，纵奇兵，假装败走，断绝赵军粮道，把赵军分断为二，士卒离心。"
    },
    {
      "personId": "zhao-xiaocheng",
      "beat": 2,
      "paragraph": 3,
      "offset": 0,
      "text": "赵王",
      "paragraphText": "赵王不听，终于用他为将。"
    }
  ]
}
