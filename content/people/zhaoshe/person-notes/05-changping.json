{
  "people": [
    {
      "id": "zhao-kuo",
      "name": "赵括",
      "versions": [
        {
          "from": 1,
          "to": 7,
          "text": "赵括是赵奢之子。本篇秦反间称「独畏马服君赵奢之子赵括」，赵王以他代廉颇；他悉更约束、易置军吏，被白起断粮分军，四十余日后战死，赵军降秦被坑。",
          "sources": [
            {
              "kind": "local",
              "id": "035"
            },
            {
              "kind": "local",
              "id": "036"
