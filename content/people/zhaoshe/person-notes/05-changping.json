              "id": "048"
            },
            {
              "kind": "local",
              "id": "056"
            },
            {
              "kind": "external",
              "book": "《史記》",
              "section": "卷八十一·廉頗藺相如列傳",
              "url": "https://zh.wikisource.org/wiki/史記/卷081"
            }
          ]
        }
      ]
    },
    {
      "id": "lin-xiangru",
      "name": "藺相如",
      "versions": [
        {
          "from": 2,
          "to": 7,
          "text": "藺相如是趙國上卿。本篇趙王以趙括代廉頗，他病中進諫「王以名使括，若膠柱而鼓瑟」，說趙括只讀父書、不知合變；趙王不聽。",
          "sources": [
            {
              "kind": "local",
              "id": "037"
            },
            {
              "kind": "local",
              "id": "038"
            },
            {
              "kind": "external",
              "book": "《史記》",
              "section": "卷八十一·廉頗藺相如列傳",
              "url": "https://zh.wikisource.org/wiki/史記/卷081"
            }
          ]
        }
      ]
    },
    {
      "id": "lian-po",
      "name": "廉頗",
      "versions": [
        {
          "from": 1,
          "to": 7,
          "text": "廉頗是趙國名將。本篇長平相拒，他固壁不戰；趙王信秦反間，以趙括代他。",
          "sources": [
            {
              "kind": "local",
              "id": "032"
            },
            {
              "kind": "local",
              "id": "033"
            },
            {
              "kind": "local",
              "id": "036"
            },
            {
              "kind": "external",
              "book": "《史記》",
              "section": "卷八十一·廉頗藺相如列傳",
              "url": "https://zh.wikisource.org/wiki/史記/卷081"
            }
          ]
        }
      ]
    },
    {
      "id": "bai-qi",
      "name": "白起",
      "versions": [
        {
          "from": 5,
          "to": 7,
          "text": "白起是秦國名將。本篇趙括代廉頗後，他縱奇兵、佯敗走、絕趙糧道、分斷趙軍，四十餘日後射殺趙括。",
          "sources": [
            {
              "kind": "local",
              "id": "050"
            },
            {
              "kind": "local",
              "id": "051"
            },
            {
              "kind": "external",
              "book": "《史記》",
              "section": "卷八十一·廉頗藺相如列傳",
              "url": "https://zh.wikisource.org/wiki/史記/卷081"
            }
          ]
        }
      ]
    },
    {
      "id": "zhao-xiaocheng",
      "name": "趙孝成王",
      "versions": [
        {
          "from": 2,
          "to": 7,
          "text": "趙孝成王是趙國之君。本篇他信秦反間，以趙括代廉頗；藺相如、括母先後進諫，他都不聽，只說「已決」。長平敗後，他因括母先言而不誅她。",
          "sources": [
            {
              "kind": "local",
              "id": "034"
            },
            {
