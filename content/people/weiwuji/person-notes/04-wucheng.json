            }
          ]
        }
      ]
    },
    {
      "id": "pingyuan-jun",
      "name": "平原君",
      "versions": [
        {
          "from": 6,
          "to": 8,
          "text": "平原君是赵公子、公子姊夫。本篇他听说公子与博徒、卖浆者交游，讥公子为「妄人」；公子要离开，他才免冠谢罪，但门下士已半去归公子。",
          "sources": [
            {
              "kind": "local",
              "id": "060"
            },
            {
              "kind": "local",
              "id": "062"
            },
            {
              "kind": "external",
              "book": "《史记》",
              "section": "卷七十七·魏公子列传",
              "url": "https://zh.wikisource.org/wiki/史記/卷077"
            }
          ]
        }
      ]
    },
    {
      "id": "mao-gong",
      "name": "毛公",
      "versions": [
        {
          "from": 5,
          "to": 8,
          "text": "毛公是赵国处士，藏身博徒之中。本篇公子闲步往访，与他交游甚欢；后来秦攻魏，他与薛公劝公子归救魏。",
          "sources": [
            {
