    {
      "id": "zhao-xiaocheng",
      "name": "赵孝成王",
      "versions": [
        {
          "from": 1,
          "to": 8,
          "text": "赵孝成王是赵国之君。本篇他感激公子矫夺晋鄙兵而存赵，与平原君计，以五城封公子；后因公子辞让，五城未献，只以鄗为汤沐邑。",
          "sources": [
