  "occurrences": [
    {
      "personId": "zhao-xiaocheng",
      "beat": 1,
      "paragraph": 2,
      "offset": 0,
      "text": "趙孝成王",
      "paragraphText": "趙孝成王感激公子假奪晉鄙之兵而存趙，於是與平原君商議，拿五城封公子。公子聽說，意氣驕矜，臉上露出自以為有功的神色。"
    },
    {
      "personId": "pingyuan-jun",
      "beat": 6,
      "paragraph": 0,
      "offset": 0,
      "text": "平原君",
      "paragraphText": "平原君聽說這件事，對他的夫人說："
    },
    {
      "personId": "mao-gong",
      "beat": 5,
      "paragraph": 0,
      "offset": 9,
      "text": "毛公",
      "paragraphText": "公子聽說趙國有處士毛公藏在博徒之中，薛公藏在賣漿的人家。公子想見兩人，兩人躲著不肯見。"
    },
    {
      "personId": "xue-gong",
      "beat": 5,
      "paragraph": 0,
      "offset": 18,
      "text": "薛公",
      "paragraphText": "公子聽說趙國有處士毛公藏在博徒之中，薛公藏在賣漿的人家。公子想見兩人，兩人躲著不肯見。"
    }
  ]
