  "occurrences": [
    {
      "personId": "zhao-xiaocheng",
      "beat": 1,
      "paragraph": 2,
      "offset": 0,
      "text": "赵孝成王",
      "paragraphText": "赵孝成王感激公子假夺晋鄙之兵而存赵，于是与平原君商议，拿五城封公子。公子听说，意气骄矜，脸上露出自以为有功的神色。"
    },
    {
      "personId": "pingyuan-jun",
      "beat": 6,
      "paragraph": 0,
      "offset": 0,
      "text": "平原君",
      "paragraphText": "平原君听说这件事，对他的夫人说："
    },
    {
      "personId": "mao-gong",
      "beat": 5,
      "paragraph": 0,
      "offset": 9,
      "text": "毛公",
      "paragraphText": "公子听说赵国有处士毛公藏在博徒之中，薛公藏在卖浆的人家。公子想见两人，两人躲着不肯见。"
    },
    {
      "personId": "xue-gong",
      "beat": 5,
      "paragraph": 0,
      "offset": 18,
      "text": "薛公",
      "paragraphText": "公子听说赵国有处士毛公藏在博徒之中，薛公藏在卖浆的人家。公子想见两人，两人躲着不肯见。"
    }
  ]
}
