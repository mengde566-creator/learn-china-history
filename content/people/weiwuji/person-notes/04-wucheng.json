        }
      ]
    },
    {
      "id": "pingyuan-jun",
      "name": "平原君",
      "versions": [
        {
          "from": 6,
          "to": 8,
          "text": "平原君是趙公子、公子姊夫。本篇他聽說公子與博徒、賣漿者交遊，譏公子為「妄人」；公子要離開，他才免冠謝罪，但門下士已半去歸公子。",
          "sources": [
            {
              "kind": "local",
              "id": "060"
            },
            {
              "kind": "local",
              "id": "062"
            },
            {
              "kind": "external",
