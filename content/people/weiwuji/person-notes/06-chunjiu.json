  "occurrences": [
    {
      "personId": "wei-anxi",
      "beat": 2,
      "paragraph": 0,
      "offset": 0,
      "text": "魏王",
      "paragraphText": "魏王天天聽到毀謗，不能不信，後來果然派人代替公子統兵。"
    },
    {
      "personId": "meng-ao",
      "beat": 4,
      "paragraph": 0,
      "offset": 9,
      "text": "蒙驁",
      "paragraphText": "秦聽說公子死了，派蒙驁攻魏，拔二十城，開始設置東郡。此後秦逐漸蠶食魏國，十八年後俘虜魏王，屠大梁。"
    },
    {
      "personId": "sima-qian",
      "beat": 5,
      "paragraph": 0,
      "offset": 0,
      "text": "太史公",
      "paragraphText": "太史公說：我經過大梁的廢墟，尋問所謂夷門。夷門，就是城的東門。天下諸公子也有好士的，但信陵君接近巖穴隱者，不以向下交結為恥，是有緣故的。名冠諸侯，不是虛言。高祖每次經過，都令百姓奉祠不絕。"
    },
    {
      "personId": "han-gaozu",
      "beat": 5,
      "paragraph": 0,
      "offset": 78,
      "text": "高祖",
      "paragraphText": "太史公說：我經過大梁的廢墟，尋問所謂夷門。夷門，就是城的東門。天下諸公子也有好士的，但信陵君接近巖穴隱者，不以向下交結為恥，是有緣故的。名冠諸侯，不是虛言。高祖每次經過，都令百姓奉祠不絕。"
    }
  ]
}
