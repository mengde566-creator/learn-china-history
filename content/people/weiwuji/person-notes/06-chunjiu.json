  "occurrences": [
    {
      "personId": "wei-anxi",
      "beat": 2,
      "paragraph": 0,
      "offset": 0,
      "text": "魏王",
      "paragraphText": "魏王天天听到毁谤，不能不信，后来果然派人代替公子统兵。"
    },
    {
      "personId": "meng-ao",
      "beat": 4,
      "paragraph": 0,
      "offset": 9,
      "text": "蒙骜",
      "paragraphText": "秦听说公子死了，派蒙骜攻魏，拔二十城，开始设置东郡。此后秦逐渐蚕食魏国，十八年后俘虏魏王，屠大梁。"
    },
    {
      "personId": "sima-qian",
      "beat": 5,
      "paragraph": 0,
      "offset": 0,
      "text": "太史公",
      "paragraphText": "太史公说：我经过大梁的废墟，寻问所谓夷门。夷门，就是城的东门。天下诸公子也有好士的，但信陵君接近岩穴隐者，不以向下交结为耻，是有缘故的。名冠诸侯，不是虚言。高祖每次经过，都令百姓奉祠不绝。"
    },
    {
      "personId": "han-gaozu",
      "beat": 5,
      "paragraph": 0,
      "offset": 78,
      "text": "高祖",
      "paragraphText": "太史公说：我经过大梁的废墟，寻问所谓夷门。夷门，就是城的东门。天下诸公子也有好士的，但信陵君接近岩穴隐者，不以向下交结为耻，是有缘故的。名冠诸侯，不是虚言。高祖每次经过，都令百姓奉祠不绝。"
    }
