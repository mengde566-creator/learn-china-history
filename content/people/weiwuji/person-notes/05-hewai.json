            }
          ]
        }
      ]
    }
  ],
  "occurrences": [
    {
      "personId": "mao-gong",
      "beat": 2,
      "paragraph": 0,
      "offset": 0,
      "text": "毛公",
      "paragraphText": "毛公、薛公两人去见公子，说："
    },
    {
      "personId": "xue-gong",
      "beat": 2,
      "paragraph": 0,
      "offset": 3,
      "text": "薛公",
      "paragraphText": "毛公、薛公两人去见公子，说："
    },
    {
      "personId": "wei-anxi",
      "beat": 3,
      "paragraph": 0,
      "offset": 0,
      "text": "魏王",
      "paragraphText": "魏王见到公子，两人相对而泣，把上将军印授给他。公子于是为将。"
    },
    {
      "personId": "meng-ao",
      "beat": 4,
      "paragraph": 1,
      "offset": 17,
      "text": "蒙骜",
      "paragraphText": "公子率五国之兵，在河外破秦军，赶走蒙骜。于是乘胜追秦军到函谷关，压住秦兵，秦兵不敢出。"
    }
  ]
