  "occurrences": [
    {
      "personId": "mao-gong",
      "beat": 2,
      "paragraph": 0,
      "offset": 0,
      "text": "毛公",
      "paragraphText": "毛公、薛公兩人去見公子，說："
    },
    {
      "personId": "xue-gong",
      "beat": 2,
      "paragraph": 0,
      "offset": 3,
      "text": "薛公",
      "paragraphText": "毛公、薛公兩人去見公子，說："
    },
    {
      "personId": "wei-anxi",
      "beat": 3,
      "paragraph": 0,
      "offset": 0,
      "text": "魏王",
      "paragraphText": "魏王見到公子，兩人相對而泣，把上將軍印授給他。公子於是為將。"
    },
    {
      "personId": "meng-ao",
      "beat": 4,
      "paragraph": 1,
      "offset": 17,
      "text": "蒙驁",
      "paragraphText": "公子率五國之兵，在河外破秦軍，趕走蒙驁。於是乘勝追秦軍到函谷關，壓住秦兵，秦兵不敢出。"
    }
  ]
}
