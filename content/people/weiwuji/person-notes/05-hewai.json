{
  "people": [
    {
      "id": "mao-gong",
      "name": "毛公",
      "versions": [
        {
          "from": 2,
          "to": 5,
          "text": "毛公是赵国处士。本篇秦攻魏，他与薛公对公子说：公子重于赵、名闻诸侯，只因为有魏；魏亡，公子有何面目立于天下。公子因此归救魏。",
          "sources": [
            {
              "kind": "local",
              "id": "065"
            },
            {
              "kind": "external",
              "book": "《史记》",
              "section": "卷七十七·魏公子列传",
              "url": "https://zh.wikisource.org/wiki/史記/卷077"
            }
          ]
        }
      ]
    },
    {
      "id": "xue-gong",
      "name": "薛公",
      "versions": [
        {
          "from": 2,
          "to": 5,
          "text": "薛公是赵国处士。本篇与毛公同劝公子归救魏；话未说完，公子已变色备车。",
          "sources": [
            {
              "kind": "local",
              "id": "065"
            },
            {
              "kind": "external",
              "book": "《史记》",
              "section": "卷七十七·魏公子列传",
              "url": "https://zh.wikisource.org/wiki/史記/卷077"
            }
          ]
        }
      ]
    },
    {
      "id": "wei-anxi",
      "name": "魏安厘王",
      "versions": [
        {
          "from": 3,
          "to": 5,
          "text": "魏安厘王是魏国之君。本篇公子归魏，他与公子相对而泣，授上将军印；公子率五国兵破秦于河外。后来秦行反间，他使人代公子将。",
          "sources": [
            {
              "kind": "local",
              "id": "067"
            },
            {
              "kind": "local",
              "id": "072"
            },
            {
