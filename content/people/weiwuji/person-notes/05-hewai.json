{
  "people": [
    {
      "id": "mao-gong",
      "name": "毛公",
      "versions": [
        {
          "from": 2,
          "to": 5,
          "text": "毛公是趙國處士。本篇秦攻魏，他與薛公對公子說：公子重於趙、名聞諸侯，只因為有魏；魏亡，公子有何面目立於天下。公子因此歸救魏。",
          "sources": [
            {
              "kind": "local",
              "id": "065"
            },
            {
              "kind": "external",
              "book": "《史記》",
              "section": "卷七十七·魏公子列傳",
              "url": "https://zh.wikisource.org/wiki/史記/卷077"
            }
          ]
        }
      ]
    },
    {
      "id": "xue-gong",
      "name": "薛公",
      "versions": [
        {
          "from": 2,
          "to": 5,
          "text": "薛公是趙國處士。本篇與毛公同勸公子歸救魏；話未說完，公子已變色備車。",
          "sources": [
            {
              "kind": "local",
              "id": "065"
            },
            {
              "kind": "external",
              "book": "《史記》",
              "section": "卷七十七·魏公子列傳",
              "url": "https://zh.wikisource.org/wiki/史記/卷077"
            }
          ]
        }
      ]
    },
    {
      "id": "wei-anxi",
      "name": "魏安釐王",
      "versions": [
        {
          "from": 3,
          "to": 5,
          "text": "魏安釐王是魏國之君。本篇公子歸魏，他與公子相對而泣，授上將軍印；公子率五國兵破秦於河外。後來秦行反間，他使人代公子將。",
          "sources": [
            {
              "kind": "local",
              "id": "067"
            },
            {
              "kind": "local",
              "id": "072"
            },
            {
