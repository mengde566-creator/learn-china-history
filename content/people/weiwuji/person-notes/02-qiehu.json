{
  "people": [
    {
      "id": "pingyuan-jun",
      "name": "平原君",
      "versions": [
        {
          "from": 1,
          "to": 8,
          "text": "平原君是赵惠文王之弟、公子姊夫。本篇邯郸被围，他派使者责公子「安在公子能急人之困」；后来公子救赵，他负韊矢为前导。",
          "sources": [
            {
              "kind": "local",
              "id": "025"
            },
            {
              "kind": "local",
              "id": "029"
            },
            {
              "kind": "local",
              "id": "048"
            },
            {
              "kind": "external",
              "book": "《史记》",
              "section": "卷七十七·魏公子列传",
              "url": "https://zh.wikisource.org/wiki/史記/卷077"
            }
          ]
        }
      ]
    },
    {
      "id": "jin-bi",
      "name": "晋鄙",
      "versions": [
        {
          "from": 1,
          "to": 8,
          "text": "晋鄙是魏将，奉命率十万众救赵。魏王惧秦，令他留军壁邺；公子持符来代，他合符而疑，说「今单车来代之，何如哉」，欲不听，终被朱亥椎杀。",
          "sources": [
            {
              "kind": "local",
              "id": "026"
            },
            {
              "kind": "local",
              "id": "028"
            },
            {
              "kind": "local",
              "id": "044"
            },
            {
              "kind": "local",
              "id": "045"
            },
            {
              "kind": "external",
              "book": "《史记》",
              "section": "卷七十七·魏公子列传",
              "url": "https://zh.wikisource.org/wiki/史記/卷077"
            }
          ]
        }
      ]
    },
    {
      "id": "ru-ji",
      "name": "如姬",
      "versions": [
        {
          "from": 5,
          "to": 8,
          "text": "如姬是魏王最宠幸的姬妾，能出入王卧内。公子曾为她报父仇，她愿为公子死；本篇她应公子之请，盗出晋鄙兵符。盗符之后的处境，所取材料未载。",
          "sources": [
            {
              "kind": "local",
              "id": "035"
            },
            {
              "kind": "local",
              "id": "036"
            },
            {
              "kind": "local",
              "id": "038"
            },
            {
              "kind": "external",
              "book": "《史记》",
              "section": "卷七十七·魏公子列传",
              "url": "https://zh.wikisource.org/wiki/史記/卷077"
            }
          ]
        }
      ]
    },
    {
      "id": "hou-ying",
      "name": "侯嬴",
      "versions": [
        {
          "from": 4,
          "to": 8,
          "text": "侯嬴是夷门监者。本篇公子赴秦军前向他辞行，他只说「勉之」；公子复返，他才献窃符之计，并约以公子至军之日自刭。",
          "sources": [
            {
              "kind": "local",
              "id": "032"
            },
            {
              "kind": "local",
              "id": "034"
            },
            {
              "kind": "local",
              "id": "043"
            },
            {
              "kind": "external",
              "book": "《史记》",
              "section": "卷七十七·魏公子列传",
              "url": "https://zh.wikisource.org/wiki/史記/卷077"
            }
          ]
        }
      ]
    },
    {
      "id": "zhu-hai",
      "name": "朱亥",
      "versions": [
        {
          "from": 7,
          "to": 8,
          "text": "朱亥是市屠者、力士。本篇侯生建议带他同行，以备晋鄙不听；他说「今公子有急，此乃臣效命之秋也」，遂与公子俱。",
          "sources": [
            {
              "kind": "local",
              "id": "040"
            },
            {
              "kind": "local",
              "id": "042"
            },
            {
              "kind": "external",
              "book": "《史记》",
              "section": "卷七十七·魏公子列传",
              "url": "https://zh.wikisource.org/wiki/史記/卷077"
            }
          ]
        }
      ]
    }
  ],
  "occurrences": [
    {
      "personId": "pingyuan-jun",
      "beat": 1,
      "paragraph": 1,
      "offset": 12,
      "text": "平原君",
      "paragraphText": "公子的姊姊是赵惠文王之弟平原君的夫人，屡次写信给魏王和公子，请救于魏。魏王派将军晋鄙率十万众救赵。"
    },
    {
      "personId": "jin-bi",
      "beat": 1,
      "paragraph": 1,
      "offset": 40,
      "text": "晋鄙",
      "paragraphText": "公子的姊姊是赵惠文王之弟平原君的夫人，屡次写信给魏王和公子，请救于魏。魏王派将军晋鄙率十万众救赵。"
    },
    {
      "personId": "ru-ji",
      "beat": 6,
      "paragraph": 0,
      "offset": 11,
      "text": "如姬",
      "paragraphText": "公子听从他的计策，去请如姬。如姬果然盗了晋鄙的兵符给公子。"
    },
    {
      "personId": "hou-ying",
      "beat": 4,
      "paragraph": 0,
      "offset": 7,
      "text": "侯生",
      "paragraphText": "路过夷门，见到侯生，公子把要去赴秦军的情况全告诉他。告辞而行，侯生只说："
    },
    {
      "personId": "zhu-hai",
      "beat": 7,
      "paragraph": 5,
      "offset": 5,
      "text": "朱亥",
      "paragraphText": "于是公子请朱亥。朱亥笑说：我是市井鼓刀的屠者，公子却多次亲自存问我；我所以不回谢，是认为小礼没有用。如今公子有急，这是我效命的时候。于是与公子同行。"
    }
  ]
}
