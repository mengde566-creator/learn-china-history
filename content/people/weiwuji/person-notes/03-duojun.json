            }
          ]
        }
      ]
    }
  ],
  "occurrences": [
    {
      "personId": "jin-bi",
      "beat": 1,
      "paragraph": 0,
      "offset": 16,
      "text": "晋鄙",
      "paragraphText": "到了邺，公子假传魏王的命令，代替晋鄙。"
    },
    {
      "personId": "zhu-hai",
      "beat": 2,
      "paragraph": 0,
      "offset": 0,
      "text": "朱亥",
      "paragraphText": "朱亥袖里藏着四十斤重的铁椎，一椎打死晋鄙。公子于是统领了晋鄙的军队。"
    },
    {
      "personId": "pingyuan-jun",
      "beat": 4,
      "paragraph": 1,
      "offset": 3,
      "text": "平原君",
      "paragraphText": "赵王与平原君亲自到边界迎接公子。平原君背着箭袋，为公子前导。赵王再拜，说："
    },
    {
      "personId": "hou-ying",
      "beat": 5,
      "paragraph": 0,
      "offset": 3,
      "text": "侯生",
      "paragraphText": "公子与侯生诀别，到了军中；侯生果然面向北方自刎。"
    }
  ]
}
