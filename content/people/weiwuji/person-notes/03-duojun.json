{
  "people": [
    {
      "id": "jin-bi",
      "name": "晋鄙",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "晋鄙是魏将，拥十万众屯于境上。本篇公子至邺，矫令代之；晋鄙合符而疑，欲不听，被朱亥以铁椎杀死。",
          "sources": [
            {
              "kind": "local",
              "id": "044"
