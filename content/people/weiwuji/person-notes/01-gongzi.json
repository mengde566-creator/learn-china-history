  "occurrences": [
    {
      "personId": "hou-ying",
      "beat": 2,
      "paragraph": 0,
      "offset": 7,
      "text": "侯嬴",
      "paragraphText": "魏国有位隐士叫侯嬴，七十岁，家里穷，做大梁夷门的看门人。"
    },
    {
      "personId": "zhu-hai",
      "beat": 4,
      "paragraph": 1,
      "offset": 18,
      "text": "朱亥",
      "paragraphText": "公子把车赶进市里。侯生下车见他的客人朱亥，斜着眼，故意站了很久，和客人说话，暗中观察公子。"
    },
    {
      "personId": "wei-anxi",
      "beat": 1,
      "paragraph": 0,
      "offset": 3,
      "text": "魏王",
      "paragraphText": "公子与魏王博戏。北境传来烽火，说赵寇到了，将入魏界。"
    }
  ]
