  "occurrences": [
    {
      "personId": "hou-ying",
      "beat": 2,
      "paragraph": 0,
      "offset": 7,
      "text": "侯嬴",
      "paragraphText": "魏國有位隱士叫侯嬴，七十歲，家裡窮，做大梁夷門的看門人。"
    },
    {
      "personId": "zhu-hai",
      "beat": 4,
      "paragraph": 1,
      "offset": 18,
      "text": "朱亥",
      "paragraphText": "公子把車趕進市裡。侯生下車見他的客人朱亥，斜著眼，故意站了很久，和客人說話，暗中觀察公子。"
    },
    {
      "personId": "wei-anxi",
      "beat": 1,
      "paragraph": 0,
      "offset": 3,
      "text": "魏王",
      "paragraphText": "公子與魏王博戲。北境傳來烽火，說趙寇到了，將入魏界。"
    }
  ]
