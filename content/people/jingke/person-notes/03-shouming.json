{
  "people": [
    {
      "id": "tian-guang",
      "name": "田光",
      "versions": [
        {
          "from": 1,
          "to": 8,
          "text": "田光已在本篇之前自刎。荆轲把他的死讯和遗言转达太子丹，说明他没有泄露秘密。",
          "sources": [
            {
              "kind": "local",
              "id": "025"
            },
            {
              "kind": "local",
              "id": "026"
            }
          ]
        }
      ]
    },
    {
      "id": "taizi-dan",
      "name": "太子丹",
      "versions": [
        {
          "from": 2,
          "to": 8,
          "text": "太子丹是燕国太子。本篇他听荆轲转达田光遗言，随后陈述刺秦计划：劫持秦王归还侵地，不成则刺杀。",
          "sources": [
            {
              "kind": "local",
              "id": "026"
            },
            {
              "kind": "local",
              "id": "027"
            },
            {
              "kind": "local",
              "id": "028"
            },
            {
              "kind": "local",
              "id": "032"
            }
          ]
        }
      ]
    },
    {
      "id": "wang-jian",
      "name": "王翦",
      "versions": [
        {
          "from": 4,
          "to": 8,
          "text": "王翦是秦国名将。本篇太子丹说秦已虏韩王，王翦率数十万众抵漳、邺；后来他攻破赵国、燕国，又率军灭楚。",
          "sources": [
            {
              "kind": "local",
              "id": "030"
            },
            {
              "kind": "external",
              "book": "《史记》",
              "section": "卷七十三·王翦列传",
              "url": "https://zh.wikisource.org/wiki/史記/卷073"
            }
          ]
        }
      ]
    },
    {
      "id": "li-xin",
      "name": "李信",
      "versions": [
        {
          "from": 4,
          "to": 8,
          "text": "李信是秦国将领。本篇太子丹说李信从太原、云中出兵；后来他攻楚失败，又与王翦灭燕、齐。",
          "sources": [
            {
              "kind": "local",
              "id": "030"
            },
            {
              "kind": "external",
              "book": "《史记》",
              "section": "卷七十三·王翦列传",
              "url": "https://zh.wikisource.org/wiki/史記/卷073"
            }
          ]
        }
      ]
    },
    {
      "id": "han-wang",
      "name": "韩王",
      "versions": [
        {
          "from": 4,
          "to": 8,
          "text": "韩王指韩王安，韩国末代君主。本篇太子丹说秦已虏韩王、尽收其地；韩在此时已亡。",
          "sources": [
            {
              "kind": "local",
              "id": "030"
            },
            {
              "kind": "external",
              "book": "《史记》",
              "section": "卷四十五·韩世家",
              "url": "https://zh.wikisource.org/wiki/史記/卷045"
            }
          ]
        }
      ]
    },
    {
      "id": "cao-mo",
      "name": "曹沫",
      "versions": [
        {
          "from": 6,
          "to": 8,
          "text": "曹沫是鲁国将领，曾在与齐桓公会盟时持匕首劫持桓公，逼他归还鲁国侵地。太子丹以此作为劫持秦王的先例。",
          "sources": [
            {
              "kind": "local",
              "id": "032"
            },
            {
              "kind": "external",
              "book": "《史记》",
              "section": "卷八十六·刺客列传",
              "url": "https://zh.wikisource.org/wiki/史記/卷086"
            }
          ]
        }
      ]
    },
    {
      "id": "qi-huangong",
      "name": "齐桓公",
      "versions": [
        {
          "from": 6,
          "to": 8,
          "text": "齐桓公是春秋时齐国君主，曾与鲁会盟，被曹沫劫持而许诺归还鲁地。",
          "sources": [
            {
              "kind": "local",
              "id": "032"
            },
            {
              "kind": "external",
              "book": "《史记》",
              "section": "卷三十二·齐太公世家",
              "url": "https://zh.wikisource.org/wiki/史記/卷032"
            }
          ]
        }
      ]
    }
  ],
