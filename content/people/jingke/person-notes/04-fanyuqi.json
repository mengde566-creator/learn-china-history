{
  "people": [
    {
      "id": "tai-zi-dan",
      "name": "燕太子丹",
      "versions": [
        {
          "from": 1,
          "to": 8,
          "text": "燕太子丹曾在秦为人质，逃回燕后接纳樊於期，又礼待荆轲，希望他谋秦。刺秦失败、秦军攻燕后，丹逃往辽东，最终被燕王喜派人杀死。",
          "sources": [
            {
              "kind": "local",
              "id": "007"
            },
            {
              "kind": "local",
              "id": "012"
            },
