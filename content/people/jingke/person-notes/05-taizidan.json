            }
          ]
        }
      ]
    },
    {
      "id": "xu-furen",
      "name": "徐夫人",
      "versions": [
        {
          "from": 1,
          "to": 7,
          "text": "《史记》称这位匕首的原主为赵人徐夫人，太子丹花百金取得匕首。“夫人”是记载中的称谓，所查正文没有说明其性别或生平。",
          "sources": [
            {
              "kind": "local",
              "id": "048"
            }
          ]
        }
      ]
    },
    {
      "id": "qin-wuyang",
      "name": "秦舞阳",
      "versions": [
        {
          "from": 2,
          "to": 7,
          "text": "秦舞阳是燕国勇士，被太子丹选为荆轲的副使。《史记》说他十三岁杀过人；后来入秦宫时，他奉地图上殿，脸色因恐惧而改变。",
          "sources": [
            {
              "kind": "local",
              "id": "049"
            },
            {
              "kind": "local",
              "id": "062"
            },
            {
              "kind": "local",
              "id": "063"
            }
          ]
        }
      ]
    }
  ],
  "occurrences": [
    {
      "personId": "tai-zi-dan",
      "beat": 1,
      "paragraph": 0,
      "offset": 0,
      "text": "太子丹",
      "paragraphText": "太子丹在天下访求锋利的匕首，花一百金买下赵国人徐夫人的那一把。"
    },
    {
      "personId": "xu-furen",
