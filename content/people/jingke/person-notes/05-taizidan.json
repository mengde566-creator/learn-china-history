{
  "people": [
    {
      "id": "tai-zi-dan",
      "name": "燕太子丹",
      "versions": [
        {
          "from": 1,
          "to": 7,
          "text": "丹是燕国太子，曾在赵国与秦王政相识，后来在秦为人质，又逃回燕国。他请荆轲谋秦；刺秦失败、秦军攻燕后，他逃往辽东，最终被燕王喜派人杀死。",
          "sources": [
