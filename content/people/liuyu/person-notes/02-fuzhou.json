{
  "people": [
    {
      "id": "liu-laozhi",
      "name": "刘牢之",
      "versions": [
        {
          "from": 1,
          "to": 8,
          "text": "刘牢之是北府兵统帅。本篇他降桓玄后失去兵权，自缢而死。",
          "sources": [
            {
              "kind": "local",
              "id": "007"
            }
          ]
        }
      ]
    },
    {
      "id": "he-wuji",
      "name": "何无忌",
      "versions": [
        {
          "from": 1,
          "to": 8,
          "text": "何无忌是刘牢之的外甥，与刘裕同谋。本篇后与刘裕起兵讨桓玄；后来在卢循之乱中战死。",
          "sources": [
            {
              "kind": "local",
              "id": "009"
            },
            {
              "kind": "local",
              "id": "024"
            },
            {
              "kind": "external",
              "book": "《晋书》",
              "section": "卷八十五·何无忌传、刘毅传、诸葛长民传",
              "url": "https://zh.wikisource.org/wiki/晉書/卷085"
            }
          ]
        }
      ]
    },
    {
      "id": "huan-xuan",
      "name": "桓玄",
      "versions": [
        {
          "from": 1,
          "to": 8,
          "text": "桓玄是荆州刺史、桓温之子。本篇他入京篡晋，称楚王；后来刘裕起兵，他败走被杀。",
          "sources": [
            {
              "kind": "local",
              "id": "007"
            },
            {
              "kind": "local",
              "id": "008"
            },
            {
              "kind": "local",
              "id": "012"
            },
            {
              "kind": "local",
              "id": "014"
            },
            {
              "kind": "external",
              "book": "《晋书》",
              "section": "卷九十九·桓玄传",
              "url": "https://zh.wikisource.org/wiki/晉書/卷99"
            }
          ]
        }
      ]
    },
    {
      "id": "huan-qian",
      "name": "桓谦",
      "versions": [
        {
          "from": 2,
          "to": 8,
          "text": "桓谦是桓玄的从兄、卫将军。本篇他试探刘裕对禅代的态度；后来屯东陵口，被义军击败。",
          "sources": [
            {
              "kind": "local",
              "id": "008"
            },
            {
              "kind": "local",
              "id": "012"
            }
          ]
        }
      ]
    },
    {
      "id": "huan-xiu",
      "name": "桓脩",
      "versions": [
        {
          "from": 3,
          "to": 8,
          "text": "桓脩是桓玄的同族。本篇他入朝，刘裕随他到京邑，随后托病回京口起事；他的结局本篇未交代。",
          "sources": [
            {
              "kind": "local",
              "id": "009"
            }
          ]
        }
      ]
    },
    {
      "id": "wang-mi",
      "name": "王谧",
      "versions": [
        {
          "from": 3,
          "to": 8,
          "text": "王谧是司徒。本篇桓玄向他称许刘裕；刘裕据石头后，他与众议推刘裕领扬州，自己任录尚书事。",
          "sources": [
            {
              "kind": "local",
              "id": "013"
            }
          ]
        }
      ]
    },
    {
      "id": "liu-yi",
      "name": "刘毅",
      "versions": [
        {
          "from": 3,
          "to": 8,
          "text": "刘毅是沛郡人，与刘裕同谋起兵。本篇后与刘裕争权，兵败被杀。",
          "sources": [
            {
              "kind": "local",
              "id": "009"
            },
            {
              "kind": "local",
              "id": "024"
            },
            {
              "kind": "external",
              "book": "《晋书》",
              "section": "卷八十五·何无忌传、刘毅传、诸葛长民传",
              "url": "https://zh.wikisource.org/wiki/晉書/卷085"
            }
          ]
        }
      ]
    },
    {
      "id": "meng-chang",
      "name": "孟昶",
      "versions": [
        {
          "from": 3,
          "to": 8,
          "text": "孟昶是平昌人，与刘裕同谋。本篇后在卢循之乱中畏惧，自杀。",
          "sources": [
            {
              "kind": "local",
              "id": "009"
            },
            {
              "kind": "local",
              "id": "026"
            }
          ]
        }
      ]
    },
    {
      "id": "tan-pingzhi",
      "name": "檀凭之",
      "versions": [
        {
          "from": 3,
          "to": 8,
          "text": "檀凭之是宁远将军，与刘裕同谋。本篇在罗落桥战死。",
          "sources": [
            {
              "kind": "local",
              "id": "011"
            }
          ]
        }
      ]
    },
    {
      "id": "liu-daogui",
      "name": "刘道规",
      "versions": [
        {
          "from": 3,
          "to": 8,
          "text": "刘道规是刘裕的弟弟，本篇参与京口起兵；后来任荆州刺史，卒于任。",
          "sources": [
            {
              "kind": "local",
              "id": "009"
            }
          ]
        }
      ]
    },
    {
      "id": "zhuge-changmin",
      "name": "诸葛长民",
      "versions": [
        {
          "from": 3,
          "to": 8,
          "text": "诸葛长民是琅邪人，与刘裕同谋。本篇负责在历阳响应；后来被刘裕杀死。",
          "sources": [
            {
              "kind": "local",
              "id": "009"
            },
            {
              "kind": "external",
              "book": "《晋书》",
              "section": "卷八十五·何无忌传、刘毅传、诸葛长民传",
              "url": "https://zh.wikisource.org/wiki/晉書/卷085"
            }
          ]
        }
      ]
    }
  ],
  "occurrences": [
    {
      "personId": "liu-laozhi",
      "beat": 1,
      "paragraph": 0,
      "offset": 30,
      "text": "刘牢之",
      "paragraphText": "元兴元年正月，司马元显西伐桓玄，桓玄也率荆州的人东下。元显派刘牢之去挡，刘裕在他军中参军事。"
    },
    {
      "personId": "he-wuji",
      "beat": 1,
      "paragraph": 1,
      "offset": 31,
      "text": "何无忌",
      "paragraphText": "桓玄到了，刘裕请战，不许。牢之要派儿子敬宣去见桓玄请和，刘裕和何无忌一起固谏，不听。"
    },
    {
      "personId": "huan-xuan",
      "beat": 1,
      "paragraph": 0,
      "offset": 13,
      "text": "桓玄",
      "paragraphText": "元兴元年正月，司马元显西伐桓玄，桓玄也率荆州的人东下。元显派刘牢之去挡，刘裕在他军中参军事。"
    },
    {
      "personId": "huan-qian",
      "beat": 2,
      "paragraph": 0,
      "offset": 19,
      "text": "桓谦",
      "paragraphText": "桓玄做了楚王，要篡位。他的堂兄、卫将军桓谦屏退左右，问刘裕：楚王勋德隆重，四海归心，朝廷的意思都说该有揖让，问他的意思。"
    },
    {
      "personId": "huan-xiu",
      "beat": 3,
      "paragraph": 1,
      "offset": 0,
      "text": "桓脩",
      "paragraphText": "桓脩入朝，刘裕跟着到了京邑。桓玄见了他，对王谧说：昨天看见刘裕，风骨不恒，是个豪杰。"
    },
    {
      "personId": "wang-mi",
      "beat": 3,
      "paragraph": 1,
      "offset": 21,
      "text": "王谧",
      "paragraphText": "桓脩入朝，刘裕跟着到了京邑。桓玄见了他，对王谧说：昨天看见刘裕，风骨不恒，是个豪杰。"
    },
    {
      "personId": "liu-yi",
      "beat": 3,
      "paragraph": 6,
      "offset": 53,
      "text": "刘毅",
      "paragraphText": "到这时桓脩还京，他推说脚上的金创发作，走不了路，便与何无忌同船回京口，定下兴复的计策。于是与弟弟道规、沛郡刘毅、平昌孟昶、任城魏咏之、高平檀凭之、琅邪诸葛长民、太原王元德、陇西辛扈兴、东莞童厚之，一同结谋。桓脩的弟弟桓弘为征虏将军、青州刺史，镇广陵；道规做桓弘的中兵参军，孟昶做州主簿。他让刘毅暗中去找孟昶，在江北聚人，谋起兵杀桓弘；诸葛长民做豫州刺史刁逵的左军府参军，谋据历阳响应；王元德、童厚之在京邑聚众攻桓玄。各定期日，一齐发动。"
    },
    {
      "personId": "meng-chang",
      "beat": 3,
      "paragraph": 6,
      "offset": 58,
      "text": "孟昶",
