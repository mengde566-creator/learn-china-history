{
  "people": [
    {
      "id": "xu-tong",
      "name": "徐统",
      "versions": [
        {
          "from": 2,
          "to": 5,
          "text": "徐统在王猛年轻游历邺城时赏识他，召他担任功曹，王猛没有接受。《晋书·王猛传》这一段没有进一步交代徐统的身份和经历。",
          "sources": [
            {
              "kind": "local",
              "id": "004"
            }
          ]
        }
      ]
    },
    {
      "id": "huan-wen",
      "name": "桓温",
      "versions": [
        {
          "from": 3,
          "to": 5,
          "text": "桓温是东晋将领，此次率军入关，王猛向他直陈关中形势。桓温邀请王猛一同南归，但王猛最终留下；桓温后来继续掌握东晋重要军政大权。",
          "sources": [
            {
              "kind": "local",
              "id": "002"
            },
            {
              "kind": "local",
              "id": "005"
            },
            {
              "kind": "external",
              "book": "《晋书》",
              "section": "卷九十八·桓温传",
              "url": "https://zh.wikisource.org/wiki/晉書/卷098"
            }
          ]
        }
      ]
    },
    {
      "id": "fu-jian",
      "name": "苻坚",
      "versions": [
        {
          "from": 5,
          "to": 5,
          "text": "苻坚是前秦皇族，此时听闻王猛之名，派吕婆楼前去招引。后来他废杀苻生、称大秦天王，重用王猛，平定前燕；王猛死后，苻坚南征东晋，在淝水失利。",
          "sources": [
