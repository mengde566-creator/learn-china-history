        }
      ]
    },
    {
      "id": "lv-polou",
      "name": "吕婆楼",
      "versions": [
        {
          "from": 5,
          "to": 5,
          "text": "吕婆楼是苻坚身边的谋士，此时奉命招引王猛。后来他参与苻坚废杀苻生，苻坚即位后任司隶校尉；王猛也进入朝廷，逐渐受到重用。",
          "sources": [
            {
