{
  "people": [
    {
      "id": "ting-zhang",
      "name": "亭长",
      "versions": [
        {
          "from": 1,
          "to": 6,
          "text": "下乡南昌亭长是秦汉时乡里的小吏，负责治安、赋役与驿传等事。本篇他收留韩信吃了几个月，妻子不再供饭；后来韩信封楚王，赐他百钱，说他「为德不卒」。",
          "sources": [
            {
              "kind": "local",
              "id": "001"
            },
            {
              "kind": "local",
              "id": "054"
            }
          ]
        }
      ]
    },
    {
      "id": "ting-zhang-qi",
      "name": "亭长妻",
      "versions": [
        {
          "from": 1,
          "to": 6,
          "text": "亭长妻是下乡南昌亭长之妻。本篇她清早做饭、在床上吃完，到饭时不替韩信备饭，韩信明白其意，怒而离去。",
          "sources": [
            {
              "kind": "local",
              "id": "001"
            }
          ]
        }
      ]
    },
    {
      "id": "piao-mu",
      "name": "漂母",
      "versions": [
        {
          "from": 2,
          "to": 6,
          "text": "漂母是在淮阴城下漂洗的老妇人。本篇她连续数十日分饭给饥饿的韩信，并拒绝他的报答许诺；后来韩信封楚王，找到她，赠以千金。",
          "sources": [
            {
              "kind": "local",
              "id": "002"
            },
            {
              "kind": "local",
              "id": "054"
            }
          ]
        }
      ]
    },
    {
      "id": "tu-zhong-shaonian",
      "name": "屠中少年",
      "versions": [
        {
          "from": 4,
          "to": 6,
          "text": "屠中少年是淮阴屠户家的少年，本篇当众羞辱韩信，要他或刺人或从袴下过。后来韩信封楚王，召见他，任为楚中尉，并对诸将说这是壮士。",
          "sources": [
            {
              "kind": "local",
              "id": "003"
            },
            {
              "kind": "local",
              "id": "054"
            }
          ]
        }
      ]
    }
  ],
  "occurrences": []
