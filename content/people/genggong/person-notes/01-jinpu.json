            }
          ]
        }
      ]
    },
    {
      "id": "da-kunmi",
      "name": "大昆彌",
      "versions": [
        {
          "from": 2,
          "to": 5,
          "text": "大昆弥是乌孙的君长。本篇耿恭移檄乌孙，大昆弥以下皆欢喜，遣使献名马，愿遣子入侍。",
          "sources": [
            {
              "kind": "local",
              "id": "006"
            },
            {
              "kind": "external",
              "book": "《後漢書》",
              "section": "卷十九·耿弇列傳附耿恭",
              "url": "https://zh.wikisource.org/wiki/後漢書/卷019"
            }
          ]
        }
      ]
    },
    {
      "id": "zuo-luli-wang",
      "name": "左鹿蠡王",
      "versions": [
        {
          "from": 3,
          "to": 5,
          "text": "左鹿蠡王是北单于派出的将领，永平十八年三月率二万骑击车师。底本不记其名。",
          "sources": [
            {
              "kind": "local",
              "id": "008"
            },
            {
              "kind": "external",
              "book": "《後漢書》",
              "section": "卷十九·耿弇列傳附耿恭",
              "url": "https://zh.wikisource.org/wiki/後漢書/卷019"
            }
          ]
        }
      ]
    },
    {
      "id": "houwang-ande",
      "name": "後王安得",
      "versions": [
        {
          "from": 3,
          "to": 5,
          "text": "安得是车师后王。匈奴破车师，杀安得，再攻金蒲城；车师后部因此无主。",
          "sources": [
            {
              "kind": "local",
              "id": "010"
            },
            {
              "kind": "external",
              "book": "《後漢書》",
              "section": "卷十九·耿弇列傳附耿恭",
              "url": "https://zh.wikisource.org/wiki/後漢書/卷019"
            }
          ]
        }
      ]
    }
  ],
  "occurrences": [
    {
      "personId": "geng-guang",
      "beat": 1,
      "paragraph": 0,
      "offset": 12,
      "text": "耿广",
      "paragraphText": "耿恭，字伯宗，是耿国之弟耿广的儿子。少年丧父。慷慨多大略，有将帅之才。"
    },
    {
      "personId": "liu-zhang",
      "beat": 1,
      "paragraph": 1,
      "offset": 10,
      "text": "刘张",
      "paragraphText": "永平十七年冬，骑都尉刘张出击车师，请耿恭为司马，与奉车都尉窦固、从弟驸马都尉耿秉一道破降车师。"
    },
    {
      "personId": "dou-gu",
      "beat": 1,
      "paragraph": 1,
      "offset": 29,
      "text": "窦固",
      "paragraphText": "永平十七年冬，骑都尉刘张出击车师，请耿恭为司马，与奉车都尉窦固、从弟驸马都尉耿秉一道破降车师。"
    },
    {
      "personId": "geng-bing",
      "beat": 1,
      "paragraph": 1,
      "offset": 38,
      "text": "耿秉",
      "paragraphText": "永平十七年冬，骑都尉刘张出击车师，请耿恭为司马，与奉车都尉窦固、从弟驸马都尉耿秉一道破降车师。"
    },
    {
      "personId": "guan-chong",
      "beat": 1,
      "paragraph": 2,
      "offset": 37,
      "text": "关宠",
      "paragraphText": "朝廷开始设置西域都护、戊己校尉，任耿恭为戊己校尉，屯车师后王部金蒲城；谒者关宠为戊己校尉，屯前王柳中城，两处各置数百人。"
    },
    {
      "personId": "da-kunmi",
      "beat": 2,
      "paragraph": 0,
      "offset": 17,
      "text": "大昆弥",
      "paragraphText": "耿恭到部，移檄乌孙，示汉威德。乌孙大昆弥以下皆欢喜，遣使献名马，并奉上宣帝时赐公主的博具，愿遣子入侍。"
    },
    {
      "personId": "houwang-ande",
      "beat": 3,
      "paragraph": 2,
      "offset": 8,
      "text": "后王安得",
      "paragraphText": "匈奴于是破杀车师后王安得，进攻金蒲城。"
    }
  ]
}
