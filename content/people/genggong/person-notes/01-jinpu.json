{
  "people": [
    {
      "id": "geng-guang",
      "name": "耿廣",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "耿广是耿国的弟弟、耿恭的父亲。底本只记他是耿恭之父，未载官职与事迹；耿恭「少孤」，父亲应早卒。",
          "sources": [
            {
              "kind": "local",
              "id": "001"
            },
            {
              "kind": "local",
              "id": "002"
            },
            {
              "kind": "external",
              "book": "《後漢書》",
              "section": "卷十九·耿弇列傳附耿恭",
              "url": "https://zh.wikisource.org/wiki/後漢書/卷019"
            }
          ]
        }
      ]
    },
    {
      "id": "liu-zhang",
      "name": "劉張",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "刘张是骑都尉，永平十七年冬出击车师的主将，请耿恭为司马。底本此后不再记他的经历。",
          "sources": [
            {
              "kind": "local",
              "id": "004"
            },
            {
              "kind": "external",
              "book": "《後漢書》",
              "section": "卷十九·耿弇列傳附耿恭",
              "url": "https://zh.wikisource.org/wiki/後漢書/卷019"
            }
          ]
        }
      ]
    },
    {
      "id": "dou-gu",
      "name": "竇固",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "窦固是奉车都尉，明帝时两次出塞击匈奴、通西域的主将。本篇与刘张、耿秉同破车师；后来耿恭上言荐其子窦固镇抚凉部。",
          "sources": [
            {
              "kind": "local",
              "id": "004"
            },
            {
              "kind": "local",
              "id": "064"
            },
            {
              "kind": "external",
              "book": "《後漢書》",
              "section": "卷十九·耿弇列傳附耿恭",
              "url": "https://zh.wikisource.org/wiki/後漢書/卷019"
            }
          ]
        }
      ]
    },
    {
      "id": "geng-bing",
      "name": "耿秉",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "耿秉是耿恭的从弟、驸马都尉，与窦固同破车师。后来官至征西将军、度辽将军，章和二年副窦宪击北匈奴，封美阳侯。",
          "sources": [
            {
              "kind": "local",
              "id": "004"
            },
            {
              "kind": "local",
              "id": "040"
            },
            {
              "kind": "external",
              "book": "《後漢書》",
              "section": "卷十九·耿弇列傳附耿恭",
              "url": "https://zh.wikisource.org/wiki/後漢書/卷019"
            }
          ]
        }
      ]
    },
    {
      "id": "guan-chong",
      "name": "關寵",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "关宠是谒者、戊己校尉，屯车师前王柳中城。匈奴围柳中，他上书求救；建初元年救兵到时，他已死。",
          "sources": [
            {
              "kind": "local",
