{
  "people": [
    {
      "id": "chen-mu",
      "name": "陈睦",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "陈睦是西域都护。永平十八年焉耆、龟兹攻杀陈睦，西域都护府随之瓦解；耿恭、关宠两支成为孤军。",
          "sources": [
            {
              "kind": "local",
              "id": "025"
            },
            {
              "kind": "external",
              "book": "《后汉书》",
              "section": "卷十九·耿弇列传附耿恭",
              "url": "https://zh.wikisource.org/wiki/后汉书/卷019"
            }
          ]
        }
      ]
    },
    {
      "id": "guan-chong",
      "name": "关宠",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "关宠是戊己校尉，屯柳中城。本篇被北匈奴围困；他上书求救，救兵未至而殁。",
          "sources": [
            {
              "kind": "local",
              "id": "025"
            },
            {
              "kind": "local",
              "id": "036"
            },
            {
              "kind": "external",
              "book": "《后汉书》",
              "section": "卷十九·耿弇列传附耿恭",
              "url": "https://zh.wikisource.org/wiki/后汉书/卷019"
            }
          ]
        }
      ]
    },
    {
      "id": "xianzong",
      "name": "显宗",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "显宗是汉明帝的庙号。永平十八年八月明帝崩，章帝即位，救兵因此不至；耿恭守城跨过这两朝。",
          "sources": [
            {
              "kind": "local",
              "id": "026"
            },
            {
              "kind": "external",
              "book": "《后汉书》",
              "section": "卷二·显宗孝明帝纪",
              "url": "https://zh.wikisource.org/wiki/后汉书/卷002"
            }
          ]
        }
      ]
    },
    {
      "id": "houwang-furen",
      "name": "后王夫人",
      "versions": [
        {
          "from": 2,
          "to": 5,
          "text": "后王夫人是先世汉人的车师后王夫人。她常把匈奴军情私下告知耿恭，又供给粮饷；底本不记其名与结局。",
          "sources": [
            {
              "kind": "local",
              "id": "028"
            },
            {
              "kind": "external",
              "book": "《后汉书》",
              "section": "卷十九·耿弇列传附耿恭",
              "url": "https://zh.wikisource.org/wiki/后汉书/卷019"
            }
          ]
        }
      ]
    },
    {
      "id": "chanyu",
      "name": "单于",
      "versions": [
        {
          "from": 4,
          "to": 5,
          "text": "此单于是北匈奴单于。他知耿恭已困，许以白屋王、妻以女子招降；使者被杀后增兵围城，仍不能下。",
          "sources": [
            {
              "kind": "local",
              "id": "031"
            },
            {
              "kind": "local",
              "id": "032"
            },
            {
              "kind": "local",
              "id": "035"
            },
            {
              "kind": "external",
              "book": "《后汉书》",
              "section": "卷十九·耿弇列传附耿恭",
              "url": "https://zh.wikisource.org/wiki/后汉书/卷019"
            }
          ]
        }
      ]
    },
    {
      "id": "shizhe",
      "name": "匈奴使者",
      "versions": [
        {
          "from": 4,
          "to": 5,
          "text": "招降使者奉单于之命入城，被耿恭诱上城亲手击杀、炙于城上；底本不记其名。",
          "sources": [
            {
              "kind": "local",
              "id": "032"
            },
            {
              "kind": "local",
              "id": "033"
            },
            {
              "kind": "external",
              "book": "《后汉书》",
              "section": "卷十九·耿弇列传附耿恭",
              "url": "https://zh.wikisource.org/wiki/后汉书/卷019"
            }
          ]
        }
      ]
    }
