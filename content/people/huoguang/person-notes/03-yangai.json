    },
    {
      "id": "ding-wairen",
      "name": "丁外人",
      "versions": [
        {
          "from": 2,
          "to": 6,
          "text": "丁外人是河间人，为鄂邑盖主所近幸。桀、安为他求封、求光禄大夫，霍光不许；后以谋反宗族被诛。",
          "sources": [
