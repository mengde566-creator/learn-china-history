  "occurrences": [
    {
      "personId": "han-wudi",
      "beat": 1,
      "paragraph": 1,
      "offset": 2,
      "text": "武帝年老",
      "paragraphText": "当时武帝年老，宠姬钩弋赵婕妤有男，武帝想立为嗣，命大臣辅之。他看群臣中只有霍光可当重任、可属社稷，便使黄门画者画周公负成王朝诸侯，赐给霍光。"
    },
    {
      "personId": "gouyi",
      "beat": 1,
      "paragraph": 1,
      "offset": 9,
      "text": "钩弋赵婕妤",
      "paragraphText": "当时武帝年老，宠姬钩弋赵婕妤有男，武帝想立为嗣，命大臣辅之。他看群臣中只有霍光可当重任、可属社稷，便使黄门画者画周公负成王朝诸侯，赐给霍光。"
    },
    {
      "personId": "jin-ridi",
      "beat": 3,
      "paragraph": 0,
      "offset": 17,
      "text": "金日䃅",
      "paragraphText": "霍光顿首推让说：「臣不如金日磾。」金日䃅也说：「臣外国人，不如光。」"
    },
    {
      "personId": "shangguan-jie",
      "beat": 4,
      "paragraph": 0,
      "offset": 22,
      "text": "上官桀",
      "paragraphText": "武帝以霍光为大司马大将军，金日䃅为车骑将军，上官桀为左将军，桑弘羊为御史大夫，皆拜卧内床下，受遗诏辅少主。"
    },
    {
      "personId": "sang-hongyang",
      "beat": 4,
      "paragraph": 0,
      "offset": 30,
      "text": "桑弘羊",
      "paragraphText": "武帝以霍光为大司马大将军，金日䃅为车骑将军，上官桀为左将军，桑弘羊为御史大夫，皆拜卧内床下，受遗诏辅少主。"
    },
    {
      "personId": "wang-hu",
      "beat": 5,
      "paragraph": 1,
      "offset": 8,
      "text": "王忽",
      "paragraphText": "当时卫尉王莽之子王忽侍中，扬言说：「帝崩，忽常在左右，安得遗诏封三子事！群儿自相贵耳。」霍光听说，切责王莽，王莽鸩杀王忽。"
    }
  ]
