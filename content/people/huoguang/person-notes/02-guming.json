            }
          ]
        }
      ]
    },
    {
      "id": "jin-ridi",
      "name": "金日䃅",
      "versions": [
        {
          "from": 3,
          "to": 5,
          "text": "金日䃅是匈奴休屠王之子，入汉为侍中，与霍光同受遗诏，为车骑将军。霍光让位于他，他以「外国人」推辞；后封秺侯，早卒。",
          "sources": [
            {
              "kind": "local",
              "id": "015"
