          ]
        }
      ]
    },
    {
      "id": "gouyi",
      "name": "钩弋赵婕妤",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "钩弋赵婕妤是武帝晚年宠姬，生昭帝刘弗陵。本传只写「有男」「立少子」，未记其结局；《外戚传》载其被谴责而死。",
          "sources": [
