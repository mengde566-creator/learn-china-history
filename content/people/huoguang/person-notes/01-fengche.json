        }
      ]
    },
    {
      "id": "huo-qubing",
      "name": "霍去病",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "霍去病是卫少儿之子、霍光异母兄，官至骠骑将军。元狩六年卒；本传只记他出征过河东迎父、带霍光入长安，不及其他战功。",
