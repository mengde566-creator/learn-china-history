{
  "people": [
    {
      "id": "huo-zhongru",
      "name": "霍中孺",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "霍中孺是河东平阳人，以县吏在平阳侯家做事，与侍者卫少皃私通生霍去病；归家娶妻后生霍光，两家绝不相闻。霍去病显贵后迎父相见，为他买田宅奴婢，又把霍光带入长安。",
          "sources": [
            {
              "kind": "local",
              "id": "001"
            },
            {
              "kind": "local",
              "id": "004"
            },
            {
