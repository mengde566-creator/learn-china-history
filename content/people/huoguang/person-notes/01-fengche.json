              "section": "卷六十八·霍光",
              "url": "https://www.gushiwen.cn/guwen/bookv_3dc36f4be479.aspx"
            }
          ]
        }
      ]
    },
    {
      "id": "wei-shaoer",
      "name": "衛少皃",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "卫少皃是平阳侯家的侍者，与霍中孺私通生霍去病；她的妹妹卫子夫后为武帝皇后。底本作「少皃」，即卫少儿。",
          "sources": [
            {
              "kind": "local",
              "id": "001"
