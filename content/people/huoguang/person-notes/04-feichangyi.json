              "section": "卷六十八·霍光",
              "url": "https://www.gushiwen.cn/guwen/bookv_3dc36f4be479.aspx"
            }
          ]
        }
      ]
    },
    {
      "id": "zhang-anshi",
      "name": "张安世",
      "versions": [
        {
          "from": 3,
          "to": 6,
          "text": "张安世是车骑将军，霍光与之暗中图计废立；收缚昌邑群臣时，他率羽林骑执行。后与霍光同辅宣帝。",
          "sources": [
            {
              "kind": "local",
              "id": "043"
            },
            {
              "kind": "local",
              "id": "049"
            },
            {
              "kind": "external",
              "book": "《汉书》",
              "section": "卷六十八·霍光",
              "url": "https://www.gushiwen.cn/guwen/bookv_3dc36f4be479.aspx"
            }
          ]
        }
      ]
    },
    {
      "id": "huang-taihou",
      "name": "皇太后",
      "versions": [
        {
          "from": 4,
          "to": 6,
          "text": "此皇太后是昭帝皇后上官氏，霍光外孙女。废昌邑时她下诏毋纳昌邑群臣、诏可废立；宣帝时尊为太皇太后。",
          "sources": [
            {
              "kind": "local",
              "id": "047"
            },
            {
              "kind": "local",
              "id": "050"
            },
            {
