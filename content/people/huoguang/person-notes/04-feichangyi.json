              "section": "卷六十八·霍光",
              "url": "https://www.gushiwen.cn/guwen/bookv_3dc36f4be479.aspx"
            }
          ]
        }
      ]
    },
    {
      "id": "yang-chang",
      "name": "杨敞",
      "versions": [
        {
          "from": 1,
          "to": 6,
          "text": "杨敞是丞相，霍光以郎书示之，遂与联名奏废昌邑王。后与霍光同奏立宣帝。",
          "sources": [
            {
              "kind": "local",
              "id": "039"
            },
