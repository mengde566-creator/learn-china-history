{
  "people": [
    {
      "id": "changyi-wang",
      "name": "昌邑王贺",
      "versions": [
        {
          "from": 2,
          "to": 6,
          "text": "刘贺是武帝之孙、昌邑哀王之子。昭帝崩，霍光迎立，在位二十七日以行淫乱被废，归昌邑；本传不记其封海昏侯事。",
          "sources": [
