  "occurrences": [
    {
      "personId": "huo-xian",
      "beat": 1,
      "paragraph": 0,
      "offset": 12,
      "text": "霍显",
      "paragraphText": "霍禹既嗣为博陆侯，太夫人霍显改霍光时所自造的茔制，加以扩大：起三出阙，筑神道，北临昭灵，南出承恩，盛饰祠室，辇阁通属永巷，而幽良人婢妾守之。"
    },
    {
      "personId": "huo-yu",
      "beat": 1,
      "paragraph": 2,
      "offset": 31,
      "text": "霍禹",
      "paragraphText": "当初霍光爱幸监奴冯子都，常与他计事；霍显寡居后，与冯子都私通。霍禹、霍山也并缮治第宅，走马驰逐平乐馆。"
    },
    {
      "personId": "huo-yun",
      "beat": 2,
      "paragraph": 0,
      "offset": 0,
      "text": "霍云",
      "paragraphText": "霍云当朝请，数次称病私出，多从宾客，张围猎于黄山苑中，使苍头奴上朝谒，莫敢谴责。"
    },
    {
      "personId": "huo-shan",
      "beat": 4,
      "paragraph": 1,
      "offset": 2,
      "text": "霍山",
      "paragraphText": "当时霍山仍领尚书，宣帝令吏民得奏封事，不关尚书；群臣进见可以独往来。于是霍氏甚恶之。"
    },
    {
      "personId": "feng-zidu",
      "beat": 1,
      "paragraph": 2,
      "offset": 8,
      "text": "冯子都",
      "paragraphText": "当初霍光爱幸监奴冯子都，常与他计事；霍显寡居后，与冯子都私通。霍禹、霍山也并缮治第宅，走马驰逐平乐馆。"
    },
    {
      "personId": "wei-xiang",
      "beat": 3,
      "paragraph": 0,
      "offset": 42,
      "text": "魏相",
      "paragraphText": "宣帝自在民间，就知道霍氏尊盛日久，内心不能善之。霍光薨后，宣帝开始躬亲朝政，御史大夫魏相给事中。"
    },
    {
      "personId": "xu-huanghou",
      "beat": 5,
      "paragraph": 0,
      "offset": 8,
      "text": "许妃",
      "paragraphText": "宣帝初立，立微时许妃为皇后。霍显爱小女成君，想把她送进宫，私下使乳医淳于衍用毒药杀许后，因劝霍光纳成君，代立为后；语在《外戚传》。"
    },
    {
      "personId": "chunyu-yan",
      "beat": 5,
      "paragraph": 1,
      "offset": 13,
      "text": "淳于衍",
      "paragraphText": "起初许后暴崩，吏捕诸医，劾淳于衍侍疾无状不道，下狱。吏簿问急，霍显恐事败，就把实情全告诉霍光。霍光大惊，想自己举发，又不忍，犹豫未决；恰逢奏上，就署衍勿论。"
    }
  ]
}
