    {
      "id": "feng-zidu",
      "name": "冯子都",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "冯子都是霍光爱幸的监奴，常与计事；霍显寡居后与他私通。后数次犯法，宣帝一并责让霍氏。",
          "sources": [
