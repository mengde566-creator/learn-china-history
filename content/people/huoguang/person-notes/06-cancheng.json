    },
    {
      "id": "xu-huanghou",
      "name": "许皇后",
      "versions": [
        {
          "from": 5,
          "to": 5,
          "text": "许皇后是宣帝微时之妃，即位后立为皇后。霍显使淳于衍毒杀她，事见《外戚传》；其子即元帝。",
          "sources": [
            {
