  "occurrences": [
    {
      "personId": "han-xuandi",
      "beat": 2,
      "paragraph": 1,
      "offset": 18,
      "text": "孝宣皇帝",
      "paragraphText": "随后霍光奉上皇帝玺绶，谒于高庙，是为孝宣皇帝。"
    },
    {
      "personId": "liu-de",
      "beat": 2,
      "paragraph": 0,
      "offset": 15,
      "text": "刘德",
      "paragraphText": "皇太后诏说：「可。」霍光遣宗正刘德到皇曾孙家尚冠里，洗沐赐御衣；太仆以軨猎车迎曾孙就斋宗正府，入未央宫见皇太后，封为阳武侯。"
    },
    {
      "personId": "huo-yu",
      "beat": 4,
      "paragraph": 1,
      "offset": 62,
      "text": "霍禹",
      "paragraphText": "霍光上书谢恩，请求分出自己国邑三千户，封兄孙奉车都尉霍山为列侯，以奉兄长骠骑将军霍去病的祭祀。事下丞相、御史，即日拜霍光之子霍禹为右将军。"
    },
    {
      "personId": "huo-shan",
      "beat": 4,
      "paragraph": 1,
      "offset": 26,
      "text": "霍山",
      "paragraphText": "霍光上书谢恩，请求分出自己国邑三千户，封兄孙奉车都尉霍山为列侯，以奉兄长骠骑将军霍去病的祭祀。事下丞相、御史，即日拜霍光之子霍禹为右将军。"
    },
    {
      "personId": "ren-xuan",
      "beat": 5,
      "paragraph": 0,
      "offset": 19,
      "text": "任宣",
      "paragraphText": "霍光薨，宣帝及皇太后亲临丧事。太中大夫任宣与侍御史五人持节护丧；中二千石治莫府冢上。赐金钱、缯絮、绣被百领、衣五十箧、璧珠玑玉衣，梓宫、便房、黄肠题凑各一具，枞木外臧椁十五具。"
    }
  ]
