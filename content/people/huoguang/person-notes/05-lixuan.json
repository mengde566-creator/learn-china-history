{
  "people": [
    {
      "id": "han-xuandi",
      "name": "漢宣帝",
      "versions": [
        {
          "from": 2,
          "to": 5,
          "text": "汉宣帝是卫太子之孙刘病已，巫蛊之祸后生长民间。昭帝崩、昌邑废，霍光等迎立；霍光归政，宣帝谦让不受，诸事先关白光，霍光死后亲政。",
          "sources": [
