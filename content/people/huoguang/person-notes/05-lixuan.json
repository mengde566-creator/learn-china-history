    {
      "id": "ren-xuan",
      "name": "任宣",
      "versions": [
        {
          "from": 5,
          "to": 5,
          "text": "任宣是太中大夫，霍光丧事时持节护丧；后为霍禹故长史，劝霍禹勿怨；又出为代郡太守。",
