            }
          ]
        }
      ]
    },
    {
      "id": "wang-zhongde",
      "name": "王仲德",
      "versions": [
        {
          "from": 2,
          "to": 7,
          "text": "王仲德又名王懿，是刘宋将领。本篇他与檀道济前往救援东阳；后来又与檀道济共同参与北伐。",
          "sources": [
