{
  "people": [
    {
      "id": "fu-rong",
      "name": "苻融",
      "versions": [
        {
          "from": 3,
          "to": 5,
          "text": "苻坚之弟，封阳平公。淝水之战为前锋主帅，马倒被杀；苻坚入城前先哭他。",
          "sources": [
            {
              "kind": "local",
              "id": "026"
            }
          ]
        }
      ]
    },
    {
      "id": "murong-chui",
      "name": "慕容垂",
      "versions": [
        {
          "from": 2,
          "to": 4,
          "text": "前燕宗室，避害奔秦。淝水后一军独全，苻坚许其巡抚燕岱，遂据关东起兵。",
          "sources": [
            {
              "kind": "local",
              "id": "026"
            }
          ]
        }
      ]
    },
    {
      "id": "murong-wei",
      "name": "慕容暐",
      "versions": [
        {
          "from": 3,
          "to": 3,
          "text": "前燕末帝。灭燕后被迁长安、封授有差；败后苻坚复其位，他却密使劝慕容泓起兵。",
          "sources": [
            {
              "kind": "local",
              "id": "026"
            }
          ]
        }
      ]
    },
    {
      "id": "zhu-xu",
      "name": "朱序",
      "versions": [
        {
          "from": 5,
          "to": 5,
          "text": "前秦尚书，本晋将。淝水战前奉命说降谢石，反把秦军虚实告知晋军，劝其速战。",
          "sources": [
            {
              "kind": "local",
              "id": "026"
            }
          ]
        }
      ]
    },
    {
      "id": "xie-shi",
      "name": "谢石",
      "versions": [
        {
          "from": 4,
          "to": 5,
          "text": "东晋都督，淝水之战晋军统帅。先惮梁成不进，后从朱序之言请战。",
          "sources": [
            {
              "kind": "local",
              "id": "026"
            }
          ]
        }
      ]
    },
    {
      "id": "xie-xuan",
      "name": "谢玄",
      "versions": [
        {
          "from": 4,
          "to": 5,
          "text": "东晋徐州刺史，淝水之战晋军主将之一，率数万列阵逼淝水。",
          "sources": [
            {
              "kind": "local",
              "id": "026"
            }
          ]
        }
      ]
    },
    {
      "id": "liu-laozhi",
      "name": "刘牢之",
      "versions": [
        {
          "from": 4,
          "to": 4,
          "text": "东晋龙骧将军。夜袭梁成营垒，斩梁成等十将，为淝水之战的前奏。",
          "sources": [
            {
              "kind": "local",
              "id": "026"
            }
          ]
        }
      ]
    },
    {
      "id": "dao-an",
      "name": "道安",
      "versions": [
        {
          "from": 1,
          "to": 1,
          "text": "当时名僧，苻坚敬信之。议伐晋时称太子之言为是，劝苻坚纳之，苻坚不听。",
          "sources": [
            {
              "kind": "local",
              "id": "026"
            }
          ]
        }
      ]
    },
    {
      "id": "fu-hong-crown",
      "name": "苻宏",
      "versions": [
        {
          "from": 1,
          "to": 1,
          "text": "苻坚的太子。议伐晋时进谏，陈吴地得岁、晋主无罪、谢安桓冲皆俊才；苻坚不听。",
          "sources": [
            {
              "kind": "local",
              "id": "026"
            }
          ]
        }
      ]
    }
  ],
  "occurrences": [
    {
      "personId": "fu-rong",
      "beat": 3,
      "paragraph": 3,
      "offset": 3,
      "text": "苻融",
      "paragraphText": "遣征南苻融、骠骑张蚝、抚军苻方、卫军梁成、平南慕容暐、冠军慕容垂率步骑二十五万为前锋。"
    },
    {
      "personId": "fu-rong",
      "beat": 4,
      "paragraph": 0,
      "offset": 0,
      "text": "苻融",
      "paragraphText": "苻融等攻陷寿春，擒晋平虏将军徐元喜、安丰太守王先。慕容垂攻陷郧城，害晋将军王太丘。"
    },
    {
      "personId": "fu-rong",
      "beat": 4,
      "paragraph": 3,
      "offset": 64,
      "text": "苻融",
      "paragraphText": "龙骧将军胡彬先保硖石，被融所逼，粮尽，诈扬沙以示融军，暗中遣使告谢石等：「如今贼盛粮尽，恐怕见不到大军了。」融军士截获使者，送到苻融处。"
    },
    {
      "personId": "fu-rong",
      "beat": 4,
      "paragraph": 7,
      "offset": 3,
      "text": "苻融",
      "paragraphText": "苻坚与苻融登城而望王师，见部阵齐整，将士精锐；又北望八公山上草木，都像人形，回头对苻融说：「这也是劲敌啊，怎么说少呢！」脸上现出惧色。"
    },
    {
      "personId": "fu-rong",
      "beat": 4,
      "paragraph": 7,
      "offset": 41,
      "text": "苻融",
      "paragraphText": "苻坚与苻融登城而望王师，见部阵齐整，将士精锐；又北望八公山上草木，都像人形，回头对苻融说：「这也是劲敌啊，怎么说少呢！」脸上现出惧色。"
    },
    {
      "personId": "fu-rong",
      "beat": 5,
      "paragraph": 3,
      "offset": 44,
      "text": "苻融",
      "paragraphText": "当时张蚝在肥南败谢石，谢玄、谢琰勒卒数万列阵以待。张蚝退，列阵逼淝水。王师不得渡，遣使对苻融说："
    },
    {
      "personId": "fu-rong",
      "beat": 5,
      "paragraph": 5,
      "offset": 0,
      "text": "苻融",
      "paragraphText": "苻融于是麾军却阵，想趁他们渡水时覆而取之。军一退便奔，制之不可止。苻融驰骑略阵，马倒被杀，军于是大败。王师乘胜追击，直到青冈，死者相枕。"
    },
    {
      "personId": "fu-rong",
      "beat": 5,
      "paragraph": 5,
      "offset": 33,
      "text": "苻融",
      "paragraphText": "苻融于是麾军却阵，想趁他们渡水时覆而取之。军一退便奔，制之不可止。苻融驰骑略阵，马倒被杀，军于是大败。王师乘胜追击，直到青冈，死者相枕。"
    },
