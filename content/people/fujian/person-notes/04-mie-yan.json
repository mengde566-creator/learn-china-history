{
  "people": [
    {
      "id": "wang-meng",
      "name": "王猛",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "北海剧人，字景略。被苻坚招致，掌机密、整吏治、灭前燕，官至丞相，临终劝苻坚勿图晋。",
          "sources": [
            {
              "kind": "local",
              "id": "016"
            }
          ]
        }
      ]
    },
    {
      "id": "yang-an",
      "name": "杨安",
      "versions": [
        {
          "from": 1,
          "to": 2,
          "text": "前秦将领。灭燕时与王猛同攻晋阳，为地道遣壮士入城。",
          "sources": [
            {
              "kind": "local",
              "id": "016"
            }
          ]
        }
      ]
    },
    {
      "id": "zhang-hao",
      "name": "张蚝",
      "versions": [
        {
          "from": 1,
          "to": 3,
          "text": "前秦猛将。攻晋阳时率壮士数百入城斩关；淝水之战为前锋之一。",
          "sources": [
            {
              "kind": "local",
              "id": "016"
            }
          ]
        }
      ]
    },
    {
      "id": "deng-qiang",
      "name": "邓羌",
      "versions": [
        {
          "from": 1,
          "to": 3,
          "text": "前秦中丞，性鲠直，与王猛协规整顿贵戚；后为潞川之战冲锋的猛将。",
          "sources": [
            {
              "kind": "local",
              "id": "016"
            }
          ]
        }
      ]
    },
    {
      "id": "murong-wei",
      "name": "慕容暐",
      "versions": [
        {
          "from": 1,
          "to": 6,
          "text": "前燕末帝。灭燕后被迁长安、封授有差；败后苻坚复其位，他却密使劝慕容泓起兵。",
          "sources": [
            {
              "kind": "local",
              "id": "016"
            }
          ]
        }
      ]
    },
    {
      "id": "murong-ping",
      "name": "慕容评",
      "versions": [
        {
          "from": 2,
          "to": 5,
          "text": "前燕太傅。率四十余万救壶关、晋阳，惮王猛不敢进，屯潞川，卖水鬻薪，一战大败。",
          "sources": [
            {
              "kind": "local",
              "id": "016"
            }
          ]
        }
      ]
    },
    {
      "id": "li-wei",
      "name": "李威",
      "versions": [
        {
          "from": 4,
          "to": 4,
          "text": "苻坚的旧臣。苻坚亲征邺城时，留他辅太子苻宏守长安。",
          "sources": [
            {
              "kind": "local",
              "id": "016"
            }
          ]
        }
      ]
    },
    {
      "id": "fu-rong",
      "name": "苻融",
      "versions": [
        {
          "from": 4,
          "to": 4,
          "text": "苻坚之弟，封阳平公。淝水之战为前锋主帅，马倒被杀；苻坚入城前先哭他。",
          "sources": [
            {
              "kind": "local",
              "id": "016"
            }
          ]
        }
      ]
    }
  ],
  "occurrences": [
    {
      "personId": "wang-meng",
      "beat": 1,
      "paragraph": 0,
      "offset": 9,
      "text": "王猛",
      "paragraphText": "太和五年，苻坚又遣王猛率杨安、张蚝、邓羌等十将，步骑六万，伐慕容暐。"
    },
    {
      "personId": "wang-meng",
      "beat": 1,
      "paragraph": 1,
      "offset": 4,
      "text": "王猛",
      "paragraphText": "他亲自把王猛送到霸东，对他说："
    },
    {
      "personId": "wang-meng",
      "beat": 2,
      "paragraph": 0,
      "offset": 6,
      "text": "王猛",
      "paragraphText": "杨安攻晋阳。王猛攻壶关，执燕上党太守慕容越，所过郡县都降于猛，猛留屯骑校尉苟苌戍守壶关。"
    },
    {
      "personId": "wang-meng",
      "beat": 3,
      "paragraph": 0,
      "offset": 0,
      "text": "王猛",
      "paragraphText": "王猛留将军毛当戍晋阳，进师与慕容评相持。"
    },
    {
      "personId": "wang-meng",
      "beat": 4,
      "paragraph": 2,
      "offset": 0,
      "text": "王猛",
      "paragraphText": "王猛悄悄到安阳迎他。坚问他：「昔年周亚夫不出军迎汉文帝，将军怎么临敌而弃众？」"
    },
    {
      "personId": "wang-meng",
      "beat": 5,
      "paragraph": 4,
      "offset": 1,
      "text": "王猛",
      "paragraphText": "以王猛为使持节、都督关东六州诸军事、车骑大将军、开府仪同三司、冀州牧，镇邺；以郭庆为持节、都督幽州诸军事、扬武将军、幽州刺史，镇蓟。"
    },
    {
      "personId": "yang-an",
      "beat": 1,
      "paragraph": 0,
      "offset": 12,
      "text": "杨安",
      "paragraphText": "太和五年，苻坚又遣王猛率杨安、张蚝、邓羌等十将，步骑六万，伐慕容暐。"
    },
    {
      "personId": "yang-an",
      "beat": 2,
      "paragraph": 0,
      "offset": 0,
      "text": "杨安",
      "paragraphText": "杨安攻晋阳。王猛攻壶关，执燕上党太守慕容越，所过郡县都降于猛，猛留屯骑校尉苟苌戍守壶关。"
    },
    {
      "personId": "yang-an",
      "beat": 2,
      "paragraph": 1,
      "offset": 2,
      "text": "杨安",
      "paragraphText": "赶上杨安攻晋阳，挖地道，派张蚝率壮士数百人潜入城中，大呼斩关，猛、安于是入晋阳，执燕并州刺史慕容庄。"
    },
    {
      "personId": "zhang-hao",
      "beat": 1,
      "paragraph": 0,
      "offset": 15,
      "text": "张蚝",
      "paragraphText": "太和五年，苻坚又遣王猛率杨安、张蚝、邓羌等十将，步骑六万，伐慕容暐。"
    },
    {
      "personId": "zhang-hao",
      "beat": 2,
      "paragraph": 1,
      "offset": 13,
      "text": "张蚝",
      "paragraphText": "赶上杨安攻晋阳，挖地道，派张蚝率壮士数百人潜入城中，大呼斩关，猛、安于是入晋阳，执燕并州刺史慕容庄。"
    },
    {
      "personId": "zhang-hao",
      "beat": 3,
      "paragraph": 8,
      "offset": 41,
      "text": "张蚝",
      "paragraphText": "羌不悦而退。不久兵交，猛召他，他睡着不应。猛驰马过去答应了他，羌于是在帐中痛饮，与张蚝、徐成等跨马运矛，驰入评军，出入数次，旁若无人，搴旗斩将，杀伤甚众。"
    },
    {
      "personId": "deng-qiang",
      "beat": 1,
      "paragraph": 0,
      "offset": 18,
      "text": "邓羌",
      "paragraphText": "太和五年，苻坚又遣王猛率杨安、张蚝、邓羌等十将，步骑六万，伐慕容暐。"
    },
    {
      "personId": "deng-qiang",
      "beat": 3,
      "paragraph": 5,
      "offset": 16,
      "text": "邓羌",
      "paragraphText": "猛望见评的军众之多，心里忌惮，对邓羌说：「今日之事，非将军不能捷。成败之机，在此一举，将军勉之！」"
    },
    {
      "personId": "murong-wei",
      "beat": 1,
      "paragraph": 0,
      "offset": 30,
      "text": "慕容暐",
      "paragraphText": "太和五年，苻坚又遣王猛率杨安、张蚝、邓羌等十将，步骑六万，伐慕容暐。"
    },
    {
      "personId": "murong-wei",
      "beat": 2,
      "paragraph": 2,
      "offset": 0,
      "text": "慕容暐",
      "paragraphText": "慕容暐派太傅慕容评率众四十余万救二城。评惮猛，不敢进，屯在潞川。"
    },
    {
      "personId": "murong-wei",
      "beat": 3,
      "paragraph": 1,
      "offset": 40,
      "text": "慕容暐",
      "paragraphText": "派游击郭庆率锐卒五千，夜里从间道绕到评营之后，傍山放火，烧其辎重，火光照进邺城。慕容暐恐惧，派使者责备慕容评，催他速战。"
    },
    {
      "personId": "murong-wei",
      "beat": 4,
      "paragraph": 4,
      "offset": 12,
      "text": "慕容暐",
      "paragraphText": "苻坚于是攻邺，攻陷了它。慕容暐出奔高阳，坚将郭庆把他擒获送来。"
    },
    {
      "personId": "murong-wei",
      "beat": 5,
      "paragraph": 3,
      "offset": 2,
      "text": "慕容暐",
      "paragraphText": "坚散慕容暐宫人珍宝以赐将士，论功封赏各有差等。"
    },
    {
      "personId": "murong-wei",
      "beat": 6,
      "paragraph": 2,
      "offset": 1,
      "text": "慕容暐",
      "paragraphText": "赦慕容暐及其王公以下，都迁往长安，封授各有差等。"
    },
    {
      "personId": "murong-ping",
      "beat": 2,
      "paragraph": 2,
      "offset": 6,
      "text": "慕容评",
      "paragraphText": "慕容暐派太傅慕容评率众四十余万救二城。评惮猛，不敢进，屯在潞川。"
    },
    {
      "personId": "murong-ping",
      "beat": 3,
      "paragraph": 0,
      "offset": 14,
      "text": "慕容评",
      "paragraphText": "王猛留将军毛当戍晋阳，进师与慕容评相持。"
    },
    {
      "personId": "murong-ping",
      "beat": 3,
      "paragraph": 1,
      "offset": 51,
      "text": "慕容评",
      "paragraphText": "派游击郭庆率锐卒五千，夜里从间道绕到评营之后，傍山放火，烧其辎重，火光照进邺城。慕容暐恐惧，派使者责备慕容评，催他速战。"
    },
    {
      "personId": "murong-ping",
      "beat": 5,
      "paragraph": 2,
      "offset": 7,
      "text": "慕容评",
      "paragraphText": "郭庆穷追余烬，慕容评奔高句丽，庆追到辽海，句丽把评绑了送来。"
    },
    {
      "personId": "li-wei",
      "beat": 4,
      "paragraph": 0,
      "offset": 8,
      "text": "李威",
      "paragraphText": "苻坚听到捷报，留李威辅太子苻宏守长安，以苻融镇洛阳，亲率精锐十万向邺。"
    },
    {
      "personId": "fu-rong",
      "beat": 4,
      "paragraph": 0,
      "offset": 20,
      "text": "苻融",
      "paragraphText": "苻坚听到捷报，留李威辅太子苻宏守长安，以苻融镇洛阳，亲率精锐十万向邺。"
    }
  ]
}
