{
  "people": [
    {
      "id": "gao-cheng",
      "name": "高澄",
      "versions": [
        {
          "from": 1,
          "to": 4,
          "text": "高澄是高欢的儿子，在父亲病重时参与处理军政事务。他替高欢写信召侯景，又向父亲坦承自己担忧侯景反叛。",
          "sources": [
            {
              "kind": "local",
              "id": "031"
            }
          ]
        }
      ]
    },
    {
      "id": "hou-jing",
      "name": "侯景",
      "versions": [
        {
          "from": 1,
          "to": 4,
          "text": "侯景是高欢早年结交的人，此时长期掌握河南兵权。他与高欢约定，来信背面有微点才应召；这次信上没有记号，他没有前来。",
          "sources": [
            {
              "kind": "local",
              "id": "004"
            },
            {
              "kind": "local",
              "id": "031"
            }
          ]
        }
      ]
    },
    {
      "id": "murong-shaozong",
      "name": "慕容绍宗",
      "versions": [
        {
          "from": 3,
          "to": 3,
          "text": "慕容绍宗曾是尔朱兆的长史，尔朱兆败亡后归附高欢。此时高欢向高澄称赞他的军事能力，并嘱咐儿子厚待他，把对付侯景的筹划交给他。关于为何从前没有抬高他，帝纪记的是高欢自己的说法。",
          "sources": [
            {
              "kind": "local",
              "id": "011"
            },
            {
              "kind": "local",
              "id": "017"
            },
            {
              "kind": "local",
              "id": "031"
            }
          ]
        }
      ]
    },
    {
      "id": "xiaojing",
      "name": "孝静帝",
      "versions": [
        {
          "from": 5,
          "to": 5,
          "text": "孝静帝元善见是高欢与百官拥立的北魏皇帝，后来随朝廷迁到邺城。高欢死后，他在东堂举哀，并参加送葬。",
          "sources": [
            {
              "kind": "local",
              "id": "022"
            },
            {
              "kind": "local",
              "id": "023"
            },
            {
              "kind": "local",
              "id": "032"
            }
          ]
        }
      ]
    }
  ],
  "occurrences": [
    {
      "personId": "gao-cheng",
      "beat": 1,
