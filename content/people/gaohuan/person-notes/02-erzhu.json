    },
    {
      "personId": "erzhu-rong",
      "beat": 1,
      "paragraph": 1,
      "offset": 29,
      "text": "尔朱荣",
      "paragraphText": "逃离杜洛周后，他们先投葛荣，又从葛荣处逃走，转往秀容，依附尔朱荣。"
    },
    {
      "personId": "erzhu-rong",
      "beat": 2,
      "paragraph": 0,
      "offset": 11,
      "text": "尔朱荣",
      "paragraphText": "刘贵帮助引见高欢。见到尔朱荣后，高欢问起他成群的马：养着这么多，究竟要拿来做什么？"
    },
    {
      "personId": "liu-gui",
      "beat": 2,
      "paragraph": 0,
      "offset": 0,
      "text": "刘贵",
      "paragraphText": "刘贵帮助引见高欢。见到尔朱荣后，高欢问起他成群的马：养着这么多，究竟要拿来做什么？"
    },
    {
      "personId": "erzhu-rong",
      "beat": 2,
      "paragraph": 1,
      "offset": 0,
      "text": "尔朱荣",
      "paragraphText": "尔朱荣让他说下去。高欢把话引向朝廷，指斥皇帝、太后与近臣，劝尔朱荣乘乱起兵、清君侧，成就霸业。两人谈到半夜，此后高欢参与军谋。"
    },
    {
      "personId": "erzhu-rong",
      "beat": 2,
      "paragraph": 1,
      "offset": 30,
      "text": "尔朱荣",
      "paragraphText": "尔朱荣让他说下去。高欢把话引向朝廷，指斥皇帝、太后与近臣，劝尔朱荣乘乱起兵、清君侧，成就霸业。两人谈到半夜，此后高欢参与军谋。"
    },
    {
      "personId": "erzhu-rong",
      "beat": 3,
      "paragraph": 0,
      "offset": 6,
      "text": "尔朱荣",
      "paragraphText": "孝明帝曾密令尔朱荣入京，后来又让他停下。皇帝突然去世，尔朱荣仍带兵进入洛阳。"
    },
    {
      "personId": "erzhu-rong",
      "beat": 3,
      "paragraph": 0,
      "offset": 27,
      "text": "尔朱荣",
      "paragraphText": "孝明帝曾密令尔朱荣入京，后来又让他停下。皇帝突然去世，尔朱荣仍带兵进入洛阳。"
    },
    {
      "personId": "xiaoming",
      "beat": 3,
      "paragraph": 0,
      "offset": 0,
      "text": "孝明帝",
      "paragraphText": "孝明帝曾密令尔朱荣入京，后来又让他停下。皇帝突然去世，尔朱荣仍带兵进入洛阳。"
    },
    {
      "personId": "xiaozhuang",
      "beat": 3,
      "paragraph": 1,
      "offset": 12,
      "text": "孝庄帝",
      "paragraphText": "帝纪接着写高欢劝止篡位、孝庄帝即位，高欢受封。进入朝廷之后，原先的献策者也开始取得封爵。"
    },
    {
      "personId": "erzhu-rong",
      "beat": 4,
      "paragraph": 0,
      "offset": 23,
      "text": "尔朱荣",
