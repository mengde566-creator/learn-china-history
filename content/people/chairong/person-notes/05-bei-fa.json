      "name": "王朴",
      "versions": [
        {
          "from": 1,
          "to": 1,
          "text": "后周枢密使，精于术数。显德六年卒；曾对世宗问年之语。",
          "sources": [
            {
              "kind": "local",
              "id": "027"
            }
          ]
        }
      ]
    },
    {
      "id": "wu-yanzuo",
