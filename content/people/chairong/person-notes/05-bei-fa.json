      "versions": [
        {
          "from": 1,
          "to": 1,
          "text": "后周宣徽南院使。世宗北征时为权东京留守。",
          "sources": [
            {
              "kind": "local",
              "id": "027"
            }
          ]
        }
      ]
    },
    {
      "id": "zan-jurun",
      "name": "昝居润",
      "versions": [
        {
          "from": 1,
          "to": 1,
          "text": "后周宣徽北院使。世宗北征时为东京留守副使。",
          "sources": [
            {
              "kind": "local",
              "id": "027"
            }
          ]
        }
      ]
    },
    {
      "id": "zhang-mei",
      "name": "张美",
      "versions": [
        {
          "from": 1,
          "to": 1,
          "text": "后周三司使。世宗北征时为大内都部署。",
          "sources": [
            {
              "kind": "local",
              "id": "027"
            }
          ]
        }
      ]
    },
    {
      "id": "wang-hong",
      "name": "王洪",
      "versions": [
        {
          "from": 2,
          "to": 2,
          "text": "北汉所署宁州刺史。显德六年以城降后周。",
          "sources": [
            {
              "kind": "local",
              "id": "027"
            }
          ]
        }
      ]
    },
    {
      "id": "gao-yanhui",
      "name": "高彦晖",
      "versions": [
        {
          "from": 3,
          "to": 3,
          "text": "辽所署瀛州刺史。显德六年以本城归顺。",
          "sources": [
            {
              "kind": "local",
              "id": "027"
            }
          ]
        }
      ]
    },
    {
      "id": "li-zhongjin",
      "name": "李重进",
      "versions": [
        {
          "from": 3,
          "to": 3,
          "text": "后周侍卫亲军都指挥使。高平之战将左厢，北伐时率诸将赴行在。",
          "sources": [
            {
              "kind": "local",
              "id": "027"
            }
          ]
        }
      ]
    }
