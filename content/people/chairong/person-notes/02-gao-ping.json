{
  "people": [
    {
      "id": "liu-chong",
      "name": "刘崇",
      "versions": [
        {
          "from": 1,
          "to": 2,
          "text": "北汉主。显德元年与契丹合兵南下，高平之战为后周所败。",
          "sources": [
            {
              "kind": "local",
              "id": "008"
            }
          ]
        }
      ]
    },
    {
      "id": "fan-aineng",
      "name": "樊爱能",
      "versions": [
        {
          "from": 1,
          "to": 4,
          "text": "后周侍卫马军都指挥使。高平之战望贼而遁，战后伏诛。",
          "sources": [
            {
              "kind": "local",
              "id": "008"
            }
          ]
        }
      ]
    },
    {
      "id": "he-hui",
      "name": "何徽",
      "versions": [
        {
          "from": 1,
          "to": 4,
          "text": "后周侍卫步军都指挥使。高平之战溃退，虽有平阳守御之功，仍与樊爱能同诛。",
          "sources": [
            {
              "kind": "local",
              "id": "008"
            }
          ]
        }
      ]
    },
    {
      "id": "li-zhongjin",
      "name": "李重进",
      "versions": [
        {
          "from": 2,
          "to": 2,
          "text": "后周侍卫亲军都指挥使。高平之战将左厢，北伐时率诸将赴行在。",
          "sources": [
            {
              "kind": "local",
              "id": "008"
            }
          ]
        }
      ]
    },
    {
      "id": "bai-zhongzan",
      "name": "白重赞",
      "versions": [
        {
          "from": 1,
          "to": 2,
          "text": "后周滑州节度使。高平之战与李重进同将左厢。",
          "sources": [
            {
              "kind": "local",
              "id": "008"
            }
          ]
        }
      ]
    },
    {
      "id": "zhang-yongde",
      "name": "张永德",
      "versions": [
        {
          "from": 2,
          "to": 2,
          "text": "后周殿前都指挥使。高平之战以禁兵卫跸；后为澶州节度使。",
          "sources": [
            {
              "kind": "local",
              "id": "008"
            }
          ]
        }
      ]
    },
    {
      "id": "liu-ci",
      "name": "刘词",
      "versions": [
        {
          "from": 3,
          "to": 3,
          "text": "后周将领。高平之战日暮领兵赶到，与大军合击，贼军再溃。",
          "sources": [
            {
              "kind": "local",
              "id": "008"
            }
          ]
        }
      ]
    },
    {
      "id": "ma-renyu",
      "name": "马仁瑀",
      "versions": [
        {
          "from": 3,
          "to": 3,
          "text": "《隆平集》所记后周勇将。高平之战呼「主辱臣死」，连毙将卒数十。",
          "sources": [
            {
              "kind": "local",
              "id": "008"
            }
          ]
        }
      ]
    }
  ],
  "occurrences": [
    {
      "personId": "liu-chong",
      "beat": 1,
      "paragraph": 0,
      "offset": 14,
      "text": "刘崇",
      "paragraphText": "三月丁丑，潞州来奏，说是河东刘崇入寇；穆令均身为兵马监押，部下的兵士遭到贼军突袭，官军失利。"
    },
    {
      "personId": "liu-chong",
      "beat": 2,
      "paragraph": 0,
      "offset": 5,
      "text": "刘崇",
      "paragraphText": "癸未，诏以刘崇入寇，车驾定于本月十一日亲征。"
    },
    {
      "personId": "liu-chong",
      "beat": 2,
      "paragraph": 2,
      "offset": 10,
      "text": "刘崇",
      "paragraphText": "车驾行次河阳时，听说刘崇自潞州南下，当即倍程而进。十八日到泽州，天色已晚，他穿着戎服在东北郊观兵，距州十五里，夜宿村舍。"
    },
    {
      "personId": "liu-chong",
      "beat": 2,
      "paragraph": 3,
      "offset": 12,
      "text": "刘崇",
      "paragraphText": "十九日，先锋与贼军相遇。刘崇的军阵列在高平县南边的高原上。有从贼中来的人说：刘崇亲自领三万骑，加上契丹一万多骑，列好阵等官军。"
    },
    {
      "personId": "liu-chong",
      "beat": 2,
      "paragraph": 3,
      "offset": 38,
      "text": "刘崇",
      "paragraphText": "十九日，先锋与贼军相遇。刘崇的军阵列在高平县南边的高原上。有从贼中来的人说：刘崇亲自领三万骑，加上契丹一万多骑，列好阵等官军。"
    },
    {
      "personId": "liu-chong",
      "beat": 2,
      "paragraph": 4,
      "offset": 6,
      "text": "刘崇",
      "paragraphText": "他催兵进击，刘崇东西列阵，也颇严整。于是命李重进、白重赞领左翼，居阵西厢；樊爱能、何徽领右翼，居阵东厢；向训、史彦超以精骑挡在正中；张永德率禁兵护卫。他骑着披甲马在阵前观战。"
    },
    {
      "personId": "fan-aineng",
      "beat": 1,
      "paragraph": 2,
      "offset": 5,
      "text": "樊爱能",
      "paragraphText": "又命向训、樊爱能、何徽、白重赞、史彦超、符彦能等，各领本部兵先赴泽州。"
    },
    {
      "personId": "fan-aineng",
      "beat": 2,
      "paragraph": 4,
      "offset": 37,
      "text": "樊爱能",
      "paragraphText": "他催兵进击，刘崇东西列阵，也颇严整。于是命李重进、白重赞领左翼，居阵西厢；樊爱能、何徽领右翼，居阵东厢；向训、史彦超以精骑挡在正中；张永德率禁兵护卫。他骑着披甲马在阵前观战。"
    },
    {
      "personId": "fan-aineng",
      "beat": 3,
      "paragraph": 0,
      "offset": 8,
      "text": "樊爱能",
      "paragraphText": "两军交锋没多久，樊爱能、何徽一见贼军掉头就跑；东厢的骑兵大乱，步军脱下甲胄投向贼军。"
    },
    {
      "personId": "fan-aineng",
      "beat": 4,
      "paragraph": 0,
      "offset": 3,
      "text": "樊爱能",
      "paragraphText": "己亥，樊爱能、何徽等将校七十多人一并伏诛。"
    },
    {
      "personId": "fan-aineng",
      "beat": 4,
      "paragraph": 1,
      "offset": 18,
      "text": "樊爱能",
      "paragraphText": "高平之役，两军既已成列，贼骑来挑战，樊爱能望风而退；何徽以步兵列于后，被奔骑冲突，即时溃乱，二将南走。他派近臣宣谕遏止，没有人肯从命，都扬言「官军大败，余众已解甲矣」。到傍晚官军克捷，才稍稍回来。"
    },
    {
      "personId": "fan-aineng",
      "beat": 4,
      "paragraph": 3,
      "offset": 23,
      "text": "樊爱能",
      "paragraphText": "他因何徽有平阳守御之功，想贷其罪，终究不可，与樊爱能一并杀了，都赐棺车归葬。"
    },
    {
      "personId": "he-hui",
      "beat": 1,
      "paragraph": 2,
      "offset": 9,
      "text": "何徽",
      "paragraphText": "又命向训、樊爱能、何徽、白重赞、史彦超、符彦能等，各领本部兵先赴泽州。"
