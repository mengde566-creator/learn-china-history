            }
          ]
        }
      ]
    },
    {
      "id": "fu-rong",
      "name": "苻融",
      "versions": [
        {
          "from": 1,
          "to": 7,
          "text": "苻融是苻坚的弟弟，曾协助前秦处理军政事务。《晋书》记他曾反对南下伐晋；本篇他先至颍口，后来在淝水战场指挥退军时阵亡。",
          "sources": [
            {
              "kind": "local",
              "id": "016"
            },
            {
              "kind": "local",
              "id": "021"
            },
            {
              "kind": "local",
              "id": "022"
            },
            {
