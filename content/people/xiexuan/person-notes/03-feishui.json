{
  "people": [
    {
      "id": "fu-jian",
      "name": "苻坚",
      "versions": [
        {
          "from": 1,
          "to": 7,
          "text": "苻坚是前秦君主，曾派军南侵荆州、淮泗。本篇他亲率大军南下，在淝水战事中中箭、军队溃败；此后前秦陷入动荡，他最终被姚苌杀害。",
          "sources": [
