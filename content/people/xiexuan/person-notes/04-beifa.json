{
  "people": [
    {
      "id": "xie-an",
      "name": "谢安",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "谢安是谢玄的叔父，淝水战后他上奏建议趁前秦战败北进。本篇谢玄受命为前锋，随后经营黄河以南地区。",
          "sources": [
            {
              "kind": "local",
              "id": "028"
            }
          ]
        }
      ]
    },
    {
      "id": "fu-jian",
      "name": "苻坚",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "苻坚是前秦君主，此前南征东晋，在淝水之战中失利。本篇谢玄等人趁前秦战败北进；苻坚后来被姚苌杀害。",
          "sources": [
            {
              "kind": "local",
              "id": "024"
            },
            {
              "kind": "local",
              "id": "025"
            },
            {
              "kind": "local",
              "id": "028"
            },
            {
              "kind": "external",
              "book": "《晋书》",
              "section": "卷一百十四·苻坚载记",
              "url": "https://zh.wikisource.org/wiki/晉書/卷114"
            }
          ]
        }
      ]
    },
    {
      "id": "huan-shiqian",
      "name": "桓石虔",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "桓石虔是东晋冠军将军，本篇随谢玄向涡水、颍水方向进军。",
          "sources": [
            {
              "kind": "local",
              "id": "028"
            }
          ]
        }
      ]
    },
    {
      "id": "liu-xi",
      "name": "刘袭",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "刘袭是谢玄的参军，本篇奉命进攻前秦兖州刺史张崇，后来又夜袭桑据。",
          "sources": [
            {
              "kind": "local",
              "id": "029"
            },
            {
              "kind": "local",
              "id": "033"
            }
          ]
        }
      ]
    },
    {
      "id": "zhang-chong",
      "name": "张崇",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "张崇是前秦兖州刺史，本篇在鄄城遭谢玄部将刘袭攻击而退走。所取谢玄传段落没有在此交代他的后续。",
          "sources": [
            {
              "kind": "local",
              "id": "029"
            }
          ]
        }
      ]
    },
    {
      "id": "liu-laozhi",
      "name": "刘牢之",
      "versions": [
        {
          "from": 1,
          "to": 5,
          "text": "刘牢之是东晋将领，此前参与淝水战事。本篇谢玄命他守鄄城，后来又派他进据碻磝。",
          "sources": [
            {
              "kind": "local",
              "id": "018"
            },
            {
              "kind": "local",
              "id": "029"
            },
            {
              "kind": "local",
              "id": "032"
            }
          ]
        }
      ]
    },
    {
      "id": "wenren-shi",
      "name": "闻人奭",
      "versions": [
        {
          "from": 2,
          "to": 5,
          "text": "闻人奭是谢玄部下的督护，本篇他提出在吕梁筑堰、立埭以利粮运的方案，谢玄予以采用。",
          "sources": [
            {
              "kind": "local",
              "id": "030"
            }
          ]
        }
      ]
    },
    {
      "id": "fu-pi",
      "name": "苻丕",
      "versions": [
        {
          "from": 4,
          "to": 5,
          "text": "苻丕是前秦君主苻坚的儿子。本篇他派桑据驻黎阳，桑据败后曾向谢玄求降；此时苻坚仍在世。",
          "sources": [
            {
              "kind": "local",
              "id": "033"
            }
          ]
        }
      ]
    },
    {
      "id": "sang-ju",
      "name": "桑据",
      "versions": [
        {
          "from": 4,
          "to": 5,
          "text": "桑据是苻丕的部将，本篇驻黎阳时遭谢玄部将刘袭夜袭，随后退走。",
          "sources": [
            {
              "kind": "local",
              "id": "033"
            }
          ]
        }
      ]
    },
    {
      "id": "gao-su",
      "name": "高素",
      "versions": [
        {
          "from": 3,
          "to": 5,
          "text": "高素是东晋淮陵太守，本篇奉谢玄之命率三千人向广固进军，前秦青州刺史苻朗随后归降。",
          "sources": [
            {
              "kind": "local",
              "id": "031"
            }
          ]
        }
      ]
    },
    {
      "id": "fu-lang",
      "name": "苻朗",
      "versions": [
        {
          "from": 3,
          "to": 5,
          "text": "苻朗是前秦青州刺史，本篇谢玄派高素向广固进军，苻朗归降东晋。",
          "sources": [
            {
              "kind": "local",
              "id": "031"
            }
          ]
        }
      ]
    },
    {
      "id": "ding-kuang",
      "name": "丁匡",
      "versions": [
        {
          "from": 3,
          "to": 5,
          "text": "丁匡是东晋济北太守，本篇受谢玄派遣与刘牢之进据碻磝。",
          "sources": [
            {
              "kind": "local",
              "id": "032"
            }
          ]
        }
      ]
    },
    {
      "id": "guo-man",
      "name": "郭满",
      "versions": [
        {
          "from": 3,
          "to": 5,
          "text": "郭满是东晋济阳太守，本篇受谢玄派遣进据滑台。",
          "sources": [
            {
              "kind": "local",
              "id": "032"
            }
          ]
        }
      ]
    },
    {
      "id": "yan-xiong",
      "name": "颜雄",
      "versions": [
        {
          "from": 3,
          "to": 5,
          "text": "颜雄是东晋奋武将军，本篇受谢玄派遣渡过黄河立营。",
          "sources": [
            {
              "kind": "local",
              "id": "032"
            }
          ]
        }
      ]
    },
    {
      "id": "teng-tianzhi",
      "name": "滕恬之",
      "versions": [
        {
          "from": 5,
          "to": 5,
          "text": "滕恬之是东晋晋陵太守，本篇受谢玄派遣渡河守黎阳；后来翟辽据黎阳时将他俘获。",
          "sources": [
            {
              "kind": "local",
              "id": "034"
            },
            {
              "kind": "local",
              "id": "038"
            }
          ]
        }
      ]
    }
  ],
  "occurrences": [
    {
