    },
    {
      "personId": "houmo-chen-yue",
      "beat": 1,
      "paragraph": 2,
      "offset": 18,
      "text": "侯莫陈悦",
      "paragraphText": "夏州有人劝他再看看局势。宇文泰判断，侯莫陈悦杀了统帅，却没能随即占住平凉，还在水洛迟疑，正可抢先行动。他带上帐下轻骑，立刻动身。"
    },
    {
      "personId": "hou-jing",
      "beat": 2,
      "paragraph": 0,
      "offset": 15,
      "text": "侯景",
      "paragraphText": "宇文泰赶往平凉时，在安定遇上了侯景。高欢也在争这支军队，派侯景来招引贺拔岳旧部。"
    },
    {
      "personId": "gao-huan",
      "beat": 2,
      "paragraph": 0,
      "offset": 18,
      "text": "高欢",
      "paragraphText": "宇文泰赶往平凉时，在安定遇上了侯景。高欢也在争这支军队，派侯景来招引贺拔岳旧部。"
    },
    {
      "personId": "yuan-xiu",
      "beat": 3,
      "paragraph": 0,
      "offset": 0,
      "text": "元修",
      "paragraphText": "元修正在设法摆脱高欢，召贺拔岳的军队到洛阳。使者到时，诸将已经推了宇文泰；皇帝随后也承认他统领这批人。"
    },
    {
      "personId": "li-bi",
      "beat": 4,
      "paragraph": 0,
      "offset": 22,
      "text": "李弼",
      "paragraphText": "到春末，宇文泰向陇右推进。侯莫陈悦退却，部将李弼又秘密遣使，愿意从内部接应宇文泰。"
    }
  ]
}
