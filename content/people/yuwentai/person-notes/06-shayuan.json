{
  "people": [
    {
      "id": "yu-jin",
      "name": "于谨",
      "versions": [
        {
          "from": 1,
          "to": 4,
          "text": "于谨是西魏的重要将领，本篇为前锋开路，参与攻弘农和沙苑合战。后来他位至柱国、大司徒，并在 554 年率军攻破江陵。",
          "sources": [
            {
              "kind": "local",
              "id": "022"
            },
            {
