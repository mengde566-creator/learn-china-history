              "section": "卷十五·于谨传、李弼传",
              "url": "https://zh.wikisource.org/wiki/周書/卷15"
            }
          ]
        }
      ]
    },
    {
      "id": "li-huibo",
      "name": "李徽伯",
      "versions": [
        {
          "from": 1,
          "to": 4,
          "text": "李徽伯是东魏的陕州刺史，守弘农。宇文泰冒雨攻城，城破后他被杀。",
          "sources": [
            {
              "kind": "local",
              "id": "022"
            }
          ]
        }
      ]
    },
    {
      "id": "gao-huan",
      "name": "高欢",
      "versions": [
        {
          "from": 2,
          "to": 4,
          "text": "高欢是东魏执政者。本篇他率大军渡河西进，在沙苑战败，夜里撤走；《北齐书》记他骑骆驼候船渡河。后来他仍多次西征，546 年攻玉壁不下，次年去世。",
          "sources": [
            {
              "kind": "local",
              "id": "023"
            },
            {
              "kind": "local",
              "id": "025"
            },
            {
              "kind": "local",
              "id": "060"
            },
            {
              "kind": "local",
              "id": "034"
            },
            {
              "kind": "local",
              "id": "070"
            }
          ]
        }
      ]
    },
    {
      "id": "wang-pi",
      "name": "王罴",
      "versions": [
        {
          "from": 2,
          "to": 4,
          "text": "王罴是西魏华州刺史。高欢军逼近华州时，他严守城池，东军知不可攻，转向别处。",
          "sources": [
            {
              "kind": "local",
              "id": "023"
            }
          ]
        }
      ]
    },
    {
      "id": "li-bi",
      "name": "李弼",
      "versions": [
        {
          "from": 3,
          "to": 4,
          "text": "李弼是西魏将领。沙苑之战前，他建议避开平地、移阵渭曲；战中率右军以铁骑横击，把东魏军截为两部。后来他位至柱国、太师，封赵国公。",
          "sources": [
            {
              "kind": "local",
              "id": "024"
            },
            {
              "kind": "local",
              "id": "025"
            },
            {
              "kind": "external",
              "book": "《周书》",
              "section": "卷十五·于谨传、李弼传",
              "url": "https://zh.wikisource.org/wiki/周書/卷15"
            }
          ]
        }
      ]
    },
    {
      "id": "zhao-gui",
      "name": "赵贵",
      "versions": [
        {
          "from": 3,
          "to": 4,
          "text": "赵贵是西魏将领，沙苑之战任左军主将。后来他位列八柱国，任大司寇，封南阳郡公。",
          "sources": [
            {
              "kind": "local",
              "id": "024"
            },
            {
              "kind": "local",
