{
  "people": [
    {
      "id": "sima-ziru",
      "name": "司马子如",
      "versions": [
        {
          "from": 1,
          "to": 4,
          "text": "司马子如是东魏将领。西魏建立之初，他率军来攻潼关；宇文泰出军霸上，他又转攻华州，被王罴击退。",
          "sources": [
            {
              "kind": "local",
              "id": "068"
            }
          ]
        }
      ]
    },
    {
      "id": "wang-pi",
      "name": "王罴",
      "versions": [
        {
          "from": 1,
          "to": 4,
          "text": "王罴是西魏的华州刺史。东魏军来攻时，他严守城池，东军知道难以攻下，转往别处。",
          "sources": [
            {
              "kind": "local",
              "id": "068"
            }
          ]
        }
      ]
    },
    {
      "id": "moqi-puba",
      "name": "万俟普拨",
      "versions": [
        {
          "from": 1,
          "to": 4,
          "text": "万俟普拨原是西方将领，任秦州刺史、建中王。大统二年他率所部投向东魏；宇文泰轻骑追赶千余里，没有追上。",
          "sources": [
            {
              "kind": "local",
              "id": "019"
            }
          ]
        }
      ]
    },
    {
      "id": "gao-huan",
      "name": "高欢",
      "versions": [
        {
          "from": 2,
          "to": 4,
          "text": "高欢是东魏的执政者。本篇他在蒲坂造浮桥、分兵三路西进，想牵住西军；窦泰败后，他撤军。后来他多次西征，546 年攻玉壁不下，次年去世。",
          "sources": [
            {
              "kind": "local",
              "id": "020"
            },
            {
              "kind": "local",
              "id": "023"
            },
            {
              "kind": "local",
              "id": "034"
            },
            {
              "kind": "local",
              "id": "070"
            }
          ]
        }
      ]
    },
    {
      "id": "dou-tai",
      "name": "窦泰",
      "versions": [
        {
          "from": 2,
          "to": 4,
          "text": "窦泰是高欢的骁将，常为先锋，屡胜而骄。本篇他率军向潼关，在小关被宇文泰突袭而败。死法两书记载不同：《周书》记斩泰、传首长安，《北齐书》记其军败自杀，人物条保留两说。",
          "sources": [
            {
              "kind": "local",
              "id": "020"
            },
            {
              "kind": "local",
              "id": "021"
            },
            {
              "kind": "local",
              "id": "059"
            }
          ]
        }
      ]
    },
    {
      "id": "gao-ang",
      "name": "高昂",
      "versions": [
        {
          "from": 2,
          "to": 4,
          "text": "高昂字敖曹，是东魏大将。本篇率一路进攻洛州，《北齐书》又记他攻剋上洛；后来在河桥之战中战死。",
          "sources": [
            {
              "kind": "local",
              "id": "020"
            },
            {
              "kind": "local",
              "id": "021"
            },
            {
              "kind": "local",
              "id": "059"
            },
            {
              "kind": "local",
              "id": "061"
            }
          ]
        }
      ]
    },
    {
      "id": "yuan-baoju",
      "name": "元宝炬",
      "versions": [
        {
          "from": 3,
          "to": 4,
          "text": "元宝炬是西魏文帝。本篇宇文泰回长安后见过皇帝、再秘密出军，这位皇帝就是他；当时西魏朝廷以元宝炬的名义运转，军国实权在宇文泰手中。",
          "sources": [
            {
              "kind": "local",
              "id": "018"
            },
            {
              "kind": "local",
              "id": "020"
            }
          ]
        }
      ]
    }
  ],
