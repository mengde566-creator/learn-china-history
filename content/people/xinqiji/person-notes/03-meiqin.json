{
  "people": [
    {
      "id": "zhao-shen",
      "name": "赵昚",
      "versions": [
        {
          "from": 2,
          "to": 7,
          "text": "孝宗是宋孝宗赵昚的庙号。本篇他在延和殿召见辛弃疾，辛弃疾陈述南北形势，并向朝廷献策。",
          "sources": [
            {
              "kind": "local",
              "id": "008"
            },
            {
              "kind": "local",
              "id": "009"
            }
          ]
        }
      ]
    },
    {
      "id": "yu-yunwen",
      "name": "虞允文",
      "versions": [
        {
          "from": 2,
          "to": 7,
          "text": "虞允文是南宋大臣，本篇辛弃疾受到孝宗召见时，他在朝中执政。此前他曾参与采石抗金，后来担任宰相。",
          "sources": [
            {
              "kind": "local",
              "id": "009"
            },
            {
              "kind": "external",
              "book": "《宋史》",
              "section": "卷三百八十三·虞允文传",
              "url": "https://zh.wikisource.org/wiki/宋史/卷383"
            }
          ]
        }
      ]
    },
    {
      "id": "ye-heng",
      "name": "叶衡",
      "versions": [
        {
          "from": 6,
          "to": 7,
          "text": "叶衡是南宋大臣，本篇在留守任上赏识辛弃疾，后来入相，向朝廷推荐他。",
          "sources": [
            {
              "kind": "local",
              "id": "010"
            },
            {
              "kind": "external",
              "book": "《宋史》",
              "section": "卷三百八十四·叶衡传",
              "url": "https://zh.wikisource.org/wiki/宋史/卷384"
            }
          ]
        }
      ]
    },
    {
      "id": "lai-wenzheng",
      "name": "赖文政",
      "versions": [
        {
          "from": 7,
          "to": 7,
          "text": "赖文政是当时在江西一带活动的武装首领；《宋史》记辛弃疾平定其部后加秘阁修撰。",
          "sources": [
            {
              "kind": "local",
              "id": "011"
            },
            {
              "kind": "local",
              "id": "013"
            }
          ]
        }
      ]
    }
  ],
  "occurrences": [
    {
      "personId": "zhao-shen",
      "beat": 2,
      "paragraph": 0,
      "offset": 5,
      "text": "孝宗",
      "paragraphText": "乾道六年，孝宗在延和殿召见问对。"
    },
    {
      "personId": "yu-yunwen",
      "beat": 2,
      "paragraph": 1,
      "offset": 2,
      "text": "虞允文",
      "paragraphText": "当时虞允文当国，皇帝锐意恢复。"
    },
    {
      "personId": "ye-heng",
      "beat": 6,
      "paragraph": 0,
      "offset": 17,
      "text": "叶衡",
      "paragraphText": "他后来被辟为江东安抚司参议官。留守叶衡很看重他。"
    },
    {
      "personId": "lai-wenzheng",
      "beat": 7,
      "paragraph": 1,
      "offset": 3,
      "text": "赖文政",
      "paragraphText": "平剧盗赖文政有功，加秘阁修撰。调京西转运判官，差知江陵府兼湖北安抚。"
    }
  ]
}
