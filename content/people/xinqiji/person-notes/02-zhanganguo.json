{
  "people": [
    {
      "id": "geng-jing",
      "name": "耿京",
      "versions": [
        {
          "from": 1,
          "to": 6,
          "text": "耿京在山东聚兵，辛弃疾曾为他的掌书记。本篇他派辛弃疾奉表归宋；辛弃疾返回途中，耿京被张安国、邵进杀害。",
          "sources": [
            {
              "kind": "local",
              "id": "003"
            },
            {
              "kind": "local",
              "id": "005"
            },
            {
              "kind": "local",
              "id": "006"
            }
          ]
        }
      ]
    },
    {
      "id": "zhao-gou",
      "name": "赵构",
      "versions": [
        {
          "from": 1,
          "to": 6,
          "text": "高宗是宋高宗赵构的庙号；本篇他在建康召见奉表归宋的辛弃疾，并授予官职。",
          "sources": [
            {
              "kind": "local",
              "id": "005"
            }
          ]
        }
      ]
    },
    {
      "id": "zhang-anguo",
      "name": "张安国",
      "versions": [
        {
          "from": 2,
          "to": 6,
          "text": "张安国与邵进杀害耿京后降金。本篇辛弃疾与王世隆、马全福等人到金营擒获他，押归后张安国被处死。",
          "sources": [
            {
              "kind": "local",
              "id": "006"
            },
            {
              "kind": "local",
              "id": "007"
            }
          ]
        }
      ]
    },
    {
      "id": "shao-jin",
      "name": "邵进",
      "versions": [
        {
          "from": 2,
          "to": 6,
          "text": "邵进与张安国杀害耿京，随后带部众降金。所取《宋史》辛弃疾传这一段没有进一步交代他的经历。",
          "sources": [
            {
              "kind": "local",
              "id": "006"
            }
          ]
        }
      ]
    },
    {
      "id": "wang-shilong",
      "name": "王世隆",
      "versions": [
        {
          "from": 4,
          "to": 6,
          "text": "王世隆是统制，本篇与辛弃疾、马全福等人前往金营，擒获张安国。",
          "sources": [
            {
              "kind": "local",
              "id": "006"
            }
          ]
        }
      ]
    },
    {
      "id": "ma-quanfu",
      "name": "马全福",
      "versions": [
        {
          "from": 4,
          "to": 6,
          "text": "马全福是《宋史》所称的忠义人，本篇与辛弃疾、王世隆等人一起前往金营。",
          "sources": [
            {
              "kind": "local",
              "id": "006"
            }
          ]
        }
      ]
    }
  ],
