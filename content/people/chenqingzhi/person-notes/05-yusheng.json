      "beat": 5,
      "paragraph": 2,
      "offset": 10,
      "text": "夏侯夔",
      "paragraphText": "朝廷命湘潭侯退与右卫夏侯夔等赴援。"
    },
    {
      "personId": "yang-qiwen",
      "beat": 1,
      "paragraph": 3,
      "offset": 4,
      "text": "杨起文",
      "paragraphText": "济阴太守杨起文弃城走了，钟离太守单希宝被害。"
    },
    {
      "personId": "shan-xibao",
      "beat": 1,
      "paragraph": 3,
      "offset": 16,
      "text": "单希宝",
      "paragraphText": "济阴太守杨起文弃城走了，钟离太守单希宝被害。"
    },
    {
      "personId": "lou-qi",
      "beat": 3,
      "paragraph": 2,
      "offset": 11,
      "text": "娄起",
      "paragraphText": "在溱水破了魏的颍州刺史娄起、扬州刺史是云宝。"
    },
    {
      "personId": "shi-yunbao",
      "beat": 3,
      "paragraph": 2,
      "offset": 18,
      "text": "是云宝",
      "paragraphText": "在溱水破了魏的颍州刺史娄起、扬州刺史是云宝。"
    },
    {
      "personId": "hou-jin",
      "beat": 3,
      "paragraph": 3,
      "offset": 14,
      "text": "侯进",
      "paragraphText": "又在楚城破了行台孙腾、大都督侯进、豫州刺史尧雄、梁州刺史司马恭。"
    },
    {
      "personId": "yao-xiong",
      "beat": 3,
      "paragraph": 3,
      "offset": 21,
