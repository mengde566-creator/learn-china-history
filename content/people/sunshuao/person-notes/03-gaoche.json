  "occurrences": [
    {
      "personId": "chu-zhuangwang",
      "beat": 1,
      "paragraph": 0,
      "offset": 9,
      "text": "庄王以为低车",
      "paragraphText": "楚国民俗喜欢低车，庄王以为低车不便马，想下令让车变高。"
    },
    {
      "personId": "lüli",
      "beat": 2,
      "paragraph": 0,
      "offset": 28,
      "text": "闾里",
      "paragraphText": "相对王说：「令数下，民不知所从，不可。王必欲高车，臣请教闾里使高其梱。乘车者皆君子，君子不能数下车。」"
    }
  ]
