  "occurrences": [
    {
      "personId": "you-meng",
      "beat": 1,
      "paragraph": 0,
      "offset": 0,
      "text": "优孟，是从前楚国的乐人",
      "paragraphText": "优孟，是从前楚国的乐人。身长八尺，多辩，常以谈笑讽谏。楚相孙叔敖知道他贤，善待他。"
    },
    {
      "personId": "sunshuao-zi",
      "beat": 2,
      "paragraph": 0,
      "offset": 5,
      "text": "其子穷困负薪",
      "paragraphText": "过了几年，其子穷困负薪，路遇优孟，与他说：「我是孙叔敖之子。父亲将死时，嘱咐我贫困时去见优孟。」"
    },
    {
      "personId": "chu-zhuangwang",
      "beat": 3,
      "paragraph": 1,
      "offset": 23,
      "text": "庄王许之",
      "paragraphText": "优孟说：「请让我回去与妻子商量，三日后为相。」庄王许之。"
    }
  ]
}
