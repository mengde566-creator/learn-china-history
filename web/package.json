{
  "name": "guanshi",
  "version": "0.1.0",
  "private": true,
  "description": "观史 —— 把史书里的一段历史，变成你可以走进去、可以开口问、走出来还记得住的场景",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "font": "node scripts/build-font.mjs",
    "check": "node scripts/build-content.mjs --check && node scripts/build-font.mjs --check",
    "dev": "npm run content && next dev",
    "build": "npm run content && npm run font && next build",
    "start": "next start",
    "verify": "node scripts/verify.mjs",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "next": "^15.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@fontsource/ma-shan-zheng": "^5.3.1",
    "playwright-core": "^1.64.0",
    "subset-font": "^2.9.0"
  }
}
